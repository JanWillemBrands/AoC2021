// SWIFT 6.3 GRAMMAR

// Grammar of a top-level declaration

// swift-syntax parseSourceFile (TopLevel.swift:47) consumes an optional leading `.shebang`
// (`#!…` interpreter line) before the top-level items. `shebang?` appears only here, in the
// root production at offset 0, and `#!` is not valid Swift anywhere else, so it can only match
// a true leading shebang. `.*` stops at end of line; the newline is then whitespace trivia.
// `shebang` must be defined before it is referenced (named terminals require prior definition).
shebang - /#!.*/ .

topLevelDeclaration = shebang? statements? .

// WHITESPACE AND COMMENT

// Grammar of whitespace

whitespace : /[\u{0000}\u{0009}\u{000A}\u{000B}\u{000C}\u{000D}\u{0020}\u{00A0}\u{FEFF}]+/ .
//whitespace = whitespaceItem whitespace? .
//whitespaceItem = lineBreak .
//whitespaceItem = inlineSpace .
//whitespaceItem = comment .
//whitespaceItem = multilineComment .
//whitespaceItem = U+0000, U+000B, or U+000C.               // NULL or \0 or \u{0000}, VERTICAL TAB or \u{000B}, or FORM FEED or \u{000C}

//lineBreak = U+000A                                        // NEWLINE or \n or \u{000A}
//lineBreak = U+000D                                        // CARRIAGE RETURN or \r or \u{000D}
//lineBreak = U+000D followed by U+000A

//inlineSpaces = inlineSpace inlineSpaces? .
//inlineSpace = U+0009 or U+0020                            // HORIZONTAL TAB or \t or \u{0009}, SPACE or \u{0020}

comment : /\/\/.*\r?\n?/ .
//comment = "//" commentText lineBreak .
//commentText = commentTextItem commentText? .
//commentTextItem = Any Unicode scalar value except U+000A or U+000D

multilineComment =: "/*" { /(?s)(?:[^*\/]|\*(?!\/)|\/(?!\*))+/ | multilineComment } "*/" .
//multilineComment = "/*" multilineCommentText "*/" .
//multilineCommentText = multilineCommentTextItem multilineCommentText? .
//multilineCommentTextItem = multilineComment .
//multilineCommentTextItem = commentTextItem .
//multilineCommentTextItem = Any Unicode scalar value except "/*" or "*/"


//IDENTIFIERS

// Grammar of an identifier

// @lexicalClass = keywords longest-matched.
// @builder regex defined in GrammarRegexLibrary.swift (SwiftGrammarRegexLibrary.identifier). Bare `_` is the wildcard, so every NAME-CONSUMING use excludes it via `---("_")`: hardIdentifier, softIdentifier, typeName, moduleGenericIdentifier, keyPathArgumentLabel, macroHead.

@lexicalClass
identifier - @builder .

escapedIdentifier - @builder .

//`implicitParameterName` ($0/$1) is NOT an identifier — swift-syntax lexes it as
// `.dollarIdentifier` and parses it as a distinct primary expression form via `parseAnonymousClosureArgument`
// (Expressions.swift:1348). It appears as its own `primaryExpression` alternate below.

implicitParameterName - /\$[0-9]+/ .

propertyWrapperProjection - @builder .   // `$name`, `$0abc` — at least one non-digit identChar after `$`; excludes `$0`, `$1` (closure shorthand)

// Most Swift identifiers exclude the hard reserved keywords
hardIdentifier  = identifier
                  ---( "_" "Any" "as" "associatedtype" "break" "case" "catch" "class" "continue" "default" "defer" "deinit" "do" "else" "enum" "extension" "fallthrough" "false" "fileprivate" "for" "func" "guard" "if" "import" "in" "init" "inout" "internal" "is" "let" "nil" "operator" "precedencegroup" "private" "protocol" "public" "repeat" "rethrows" "return" "self" "Self" "static" "struct" "subscript" "super" "switch" "throw" "throws" "true" "try" "typealias" "var" "where" "while" )   // `open`/`await` removed: NOT lexer-classified in swift-syntax (IsLexerClassified.swift) — contextual, usable as identifier/callee (`open(set)` call, `func await()`). `init` kept excluded: also non-reserved but removing it adds 6 init-decl-vs-identifier ambiguities (measured), no gain.
                | escapedIdentifier
                | propertyWrapperProjection .

// Swift allows keywords as argument labels and as member names, just a few keywords are excluded for legacy reasons.
softIdentifier  = identifier
                  ---( "_" "let" "var" "inout" )
                | escapedIdentifier
                | propertyWrapperProjection .

identifierList = hardIdentifier | hardIdentifier "," identifierList .

// MODULE SELECTOR — SE-0491 (accepted). A referenced name may be prefixed by `Module::` to
// disambiguate which module it comes from. swift-syntax parseModuleSelectorIfPresent (Names.swift:125)
// consumes `name ::` before the actual name in both expression and type positions. `::` is a new
// token used nowhere else, so threading `moduleSelector?` through name positions adds no ambiguity.
// `>n<` after `::` = the base name must be on the SAME line as `::`. Faithful to swift-syntax
// `consumeModuleSelectorTokensIfPresent` (Names.swift): `skipQualifiedName = afterContainsAnyNewline`
// — a newline between `::` and the base name skips the qualified name → missing base name → hasError
// (`Swift::⏎print`, `Swift ::⏎print`, `Swift⏎::⏎print`, `Swift::⏎do`).
// `@excludedFrom(valueBindingPattern)`: inside a `let`/`var` binding pattern a name is INTRODUCED,
// and swift-syntax parses it as a plain identifier — a module selector's `::x` is left as unexpected
// code → hasError (`case let Optional.some(Swift::decl)`, `case let Swift::decl?`). A module selector
// only qualifies a REFERENCE, so prune it wherever it lands inside a binding pattern.
moduleSelector = @excludedFrom(valueBindingPattern) hardIdentifier "::" >n< . // TODO: I don't think escapedIdentifier and propertyWrapperProjection should be moduleSelector.

//identifier = identifierHead identifierCharacters? .
//identifier = "`" identifierHead identifierCharacters? "`" .
//identifier = implicitParameterName .
//identifier = propertyWrapperProjection .

//identifierHead = Upper or lowercase letter A through Z
//identifierHead = "_" .
//identifierHead = U+00A8, U+00AA, U+00AD, U+00AF, U+00B2–U+00B5, or U+00B7–U+00BA
//identifierHead = U+00BC–U+00BE, U+00C0–U+00D6, U+00D8–U+00F6, or U+00F8–U+00FF
//identifierHead = U+0100–U+02FF, U+0370–U+167F, U+1681–U+180D, or U+180F–U+1DBF
//identifierHead = U+1E00–U+1FFF
//identifierHead = U+200B–U+200D, U+202A–U+202E, U+203F–U+2040, U+2054, or U+2060–U+206F
//identifierHead = U+2070–U+20CF, U+2100–U+218F, U+2460–U+24FF, or U+2776–U+2793
//identifierHead = U+2C00–U+2DFF or U+2E80–U+2FFF
//identifierHead = U+3004–U+3007, U+3021–U+302F, U+3031–U+303F, or U+3040–U+D7FF
//identifierHead = U+F900–U+FD3D, U+FD40–U+FDCF, U+FDF0–U+FE1F, or U+FE30–U+FE44
//identifierHead = U+FE47–U+FFFD
//identifierHead = U+10000–U+1FFFD, U+20000–U+2FFFD, U+30000–U+3FFFD, or U+40000–U+4FFFD
//identifierHead = U+50000–U+5FFFD, U+60000–U+6FFFD, U+70000–U+7FFFD, or U+80000–U+8FFFD
//identifierHead = U+90000–U+9FFFD, U+A0000–U+AFFFD, U+B0000–U+BFFFD, or U+C0000–U+CFFFD
//identifierHead = U+D0000–U+DFFFD or U+E0000–U+EFFFD

//identifierCharacter = Digit 0 through 9
//identifierCharacter = U+0300–U+036F, U+1DC0–U+1DFF, U+20D0–U+20FF, or U+FE20–U+FE2F
//identifierCharacter = identifierHead .
//identifierCharacters = identifierCharacter identifierCharacters? .

//implicitParameterName = "$" decimalDigits .
//propertyWrapperProjection = "$" identifierCharacters .


// REGULAR EXPRESSIONS

// Grammar of a regular expression literal


// ──────────────────────────────────────────────────────────────────────────
// Plain slash-regex literal — parser-level CFG, position-gated at the opening `/`.
//
// The CFG body (regexBody/regexItem/regexGroup/regexCharacterClass) correctly balances
// groups `(…)` and classes `[…]` — genuinely context-free structure a flat scanner
// terminal cannot express. Regex-body atoms reach the body through the SAME operator
// terminals (regexOperatorChar etc.), so `/^/`, `/(.*?)/` parse cleanly.
//
// Regex-vs-operator disambiguation (mirrors swift-syntax's lexer):
//   • Position gate — `regexOpenSlash` carries the `<-<` operand-ender exclusion list:
//     the `preferRegexOverBinaryOperator` analog (Cursor.swift:2255). A regex may start
//     only when NOT preceded by an operand-ender; in infix position a leading `/` stays
//     division/operator. The CLOSING slash (`regexCloseSlash`) is ungated — a regex body
//     may legitimately end in `)`/`]`, which would wrongly trip the operand-ender list.
//   • Operator maximal-munch — `@lexicalClass operatorToken` (no `@splitBefore`) makes
//     `=/`, `+/`, `.../` single operators and suppresses the lone `+`/`=`/`.`, so no
//     `op` + `/regex/` split survives in infix position (`/x/+/y/`, `_=/0/`, `0 /^/ 1`).
//   • regexOpenSlash/regexCloseSlash are REGEX terminals → exempt from operator
//     maximal-munch, so a regex's own `/` is never eaten as an operator char.
// ──────────────────────────────────────────────────────────────────────────

regexEscape          - /\\[^\r\n]/ .
regexNonOperatorAtom - /[^\/\\\[\]\(\)\r\n\+\-\*%&\|\^~<>=!\?\.#;:,]/ .
regexClassAtom       - /[^\\\]\r\n]/ .
// A single operator character inside a regex body. A REGEX terminal (not the shared
// operator literals) so it is exempt from operatorToken maximal munch — otherwise
// `/^/`'s `^` would be eaten as the operator `^/`, and `/(.*?)/`'s `*?` would fuse.
// Excludes `/` (the regex delimiter, matched by regexOpenSlash/regexCloseSlash).
regexOperatorChar    - /[-+*%|^~<>=!?&.]/ .

// Opening slash — position-gated. `<-<` (negative lookbehind) blocks a regex start right
// after an operand-ender, the `preferRegexOverBinaryOperator` analog.
regexOpenSlash  - /\// .
     <-< ( "true" "false" "nil" "self" "Self" "super" "Any"
         "func" "operator"
         identifier escapedIdentifier implicitParameterName propertyWrapperProjection
         binaryLiteral octalLiteral decimalLiteral hexadecimalLiteral
         decimalFloatingPointLiteral hexadecimalFloatingPointLiteral
         regexCloseSlash extendedRegularExpressionLiteral
         "_" ")" "]" "}" ">"
         "!"
         "->" "..." "." "@" )
regexCloseSlash - /\// .
// Ungated opening slash for a NEWLINE-leading regex. A `/…/ ` that starts a new line after a
// complete expression is a regex, not infix division (`_ = 2 ⏎ /x}/` → RegexLiteral, probe-
// confirmed hasError=false). The newline resets to prefix position, so the operand-ender gate
// must NOT apply — hence a separate ungated slash. The spaced continuation `⏎/ 1` is still
// excluded by `>s<` (no space after the opening `/`), matching swift's line-leading operator rule.
regexOpenSlashNL - /\// .
// Two mutually-exclusive productions (`>n<` = no newline before, `<n>` = newline before):
//   same line  → gated opening slash (operand-ender lookbehind blocks `0 /^/ 1`)
//   new line   → ungated opening slash (line-leading `/x}/` is a regex)
plainRegularExpressionLiteral = >n< regexOpenSlash   >s< regexBody >s< regexCloseSlash .
plainRegularExpressionLiteral = <n> regexOpenSlashNL >s< regexBody >s< regexCloseSlash .

regexBody       = regexItem | regexItem regexBody .
regexItem       = regexEscape | regexCharacterClass | regexGroup | regexAtom .
regexGroup      = "(" regexBody ")" .
regexCharacterClass = "[" regexClassBody "]" .
regexClassBody  = regexClassItem | regexClassItem regexClassBody .   // Swift forbids []
regexClassItem  = regexEscape | regexClassAtom .

// Operator-overlap-safe atom reachable through existing terminals.
regexAtom       = regexNonOperatorAtom
                | regexOperatorChar
                | "#" | ":" | ";" | "," .

// backref: closing #s must equal opening; no escapes in extended regex, `/` is body content, only `/#…` closes
extendedRegularExpressionLiteral    - /(#+)\/(?:[^\/]|\/(?!\1))*?\/\1/ .
     <-< ( "true" "false" "nil" "self" "Self" "super" "Any"
         "func" "operator"
         identifier escapedIdentifier implicitParameterName propertyWrapperProjection
         binaryLiteral octalLiteral decimalLiteral hexadecimalLiteral
         decimalFloatingPointLiteral hexadecimalFloatingPointLiteral
         plainRegularExpressionLiteral extendedRegularExpressionLiteral
         ")" "]" "}" ">"
         "!"
         "->" "..." "." "@" )

regularExpressionLiteral = plainRegularExpressionLiteral | extendedRegularExpressionLiteral .

//regularExpressionLiteral = regularExpressionLiteralOpeningDelimiter regularExpression regularExpressionLiteralClosingDelimiter .
//regularExpression = Any regular expression
//regularExpressionLiteralOpeningDelimiter = extendedRegularExpressionLiteralDelimiter? "/" .
//regularExpressionLiteralClosingDelimiter = "/" extendedRegularExpressionLiteralDelimiter? .
//extendedRegularExpressionLiteralDelimiter = "#" extendedRegularExpressionLiteralDelimiter? .


// STRINGS

// Grammar of a string literal

stringLiteral = staticStringLiteral | interpolatedStringLiteral .

singleLineStringLiteral         - /"(?:[^"\\\n\r]|\\u\{[0-9a-fA-F]+\}|\\[0\\tnr"']|\\(?!\().)*?"/ . // start with " end with " same line, no \( interpolation start
extendedSinglelineStringLiteral - /(#+)"(?:[^"\n\r]|"(?!\1))*?"\1/ .   // backref: closing #s must equal opening

multilineStringLiteral          - /"""(?![\s\S]*\\\()(?:[^"\\]|\\[\s\S]|"(?!""))*"""/ . // start """ end """; body's `\<x>` uses `[\s\S]` so `\<NL>` (multiline line-continuation per swift-syntax Cursor.swift:1766) is body content; lookahead uses `[\s\S]` so it crosses newlines
extendedMultilineStringLiteral  - /(#+)"""[ \t]*\r?\n(?s:.)*?"""\1/ .   // backref: closing #s must equal opening. `[ \t]*\r?\n` after the opening `#"""`: swift requires a multiline opener to be followed by a newline (Cursor.swift advanceIfMultilineDelimiter). Without it, `#"""…"""#` is a SINGLE-line raw string with `"` content ("false delimiters" — probe: `#""""""#` → stringQuote, not multilineStringQuote), which resolves the extendedSingleline-vs-extendedMultiline ambiguity on quote-only raw bodies.

staticStringLiteral             = singleLineStringLiteral
                                | extendedSinglelineStringLiteral
                                | multilineStringLiteral
                                | extendedMultilineStringLiteral .
                                
// Under LCNP these terminals are queried per-slot, so the spurious matches that
// would happen outside an interpolated-string context are never asked for.
interpolatedStringLiteralHead   - /"(?:[^"\\\n\r]|\\u\{[0-9a-fA-F]+\}|\\[0\\tnr"']|\\.)*?\\\(/ .     // start with ", end with \( same line

interpolatedStringLiteralPart   - /\)(?:[^"\\\n\r]|\\u\{[0-9a-fA-F]+\}|\\[0\\tnr"']|\\.)*?\\\(/ .    // start with ), end with \( same line

interpolatedStringLiteralTail   - /\)(?:[^"\\\n\r]|\\u\{[0-9a-fA-F]+\}|\\[0\\tnr"']|\\(?!\().)*?"/ . // start with ), end with " same line, no \(

// Multiline variants — structurally symmetric to the single-line trio above.
// Differences: open is """ (Head), close is """ (Tail); content alternation adds `"(?!"")` so a single `"`
// (not followed by `""`) is valid body content — the only multiline-specific feature.
// Multiline body's catch-all backslash uses `[\s\S]` (not `.`) so `\<NL>` line-continuation per swift-syntax Cursor.swift:1766 is body content.
multilineInterpolatedStringLiteralHead - /"""(?:[^"\\]|\\u\{[0-9a-fA-F]+\}|\\[0\\tnr"']|\\[\s\S]|"(?!""))*?\\\(/ .  // start with """, end with \(

multilineInterpolatedStringLiteralPart - /\)(?:[^"\\]|\\u\{[0-9a-fA-F]+\}|\\[0\\tnr"']|\\[\s\S]|"(?!""))*?\\\(/ .   // start with ),    end with \(

multilineInterpolatedStringLiteralTail - /\)(?:[^"\\]|\\u\{[0-9a-fA-F]+\}|\\(?!\()[\s\S]|"(?!""))*?"""/ . // start with ), end with """; body's `\<x>` (x ≠ `(`) uses [\s\S] so `\<NL>` is body content

interpolatedStringLiteral       = interpolatedStringLiteralHead
                                  functionCallArgumentList { interpolatedStringLiteralPart functionCallArgumentList }
                                  interpolatedStringLiteralTail .
interpolatedStringLiteral       = multilineInterpolatedStringLiteralHead
                                  functionCallArgumentList { multilineInterpolatedStringLiteralPart functionCallArgumentList }
                                  multilineInterpolatedStringLiteralTail .



//stringLiteralOpeningDelimiter = extendedStringLiteralDelimiter? "\"" .
//stringLiteralClosingDelimiter = "\"" extendedStringLiteralDelimiter? .

//staticStringLiteral = stringLiteralOpeningDelimiter quotedText? stringLiteralClosingDelimiter .
//staticStringLiteral = multilineStringLiteralOpeningDelimiter multilineQuotedText? multilineStringLiteralClosingDelimiter .

//multilineStringLiteralOpeningDelimiter = extendedStringLiteralDelimiter? "\"\"\"" .
//multilineStringLiteralClosingDelimiter = "\"\"\"" extendedStringLiteralDelimiter? .
//extendedStringLiteralDelimiter = "#" extendedStringLiteralDelimiter? .

//quotedText = quotedTextItem quotedText? .
//quotedTextItem = escapedCharacter .
//quotedTextItem = Any Unicode scalar value except ", \, U+000A, or U+000D

//multilineQuotedText = multilineQuotedTextItem multilineQuotedText? .
//multilineQuotedTextItem = escapedCharacter .
//multilineQuotedTextItem = Any Unicode scalar value except \
//multilineQuotedTextItem = escapedNewline .

//interpolatedStringLiteral = stringLiteralOpeningDelimiter interpolatedText? stringLiteralClosingDelimiter .
//interpolatedStringLiteral = multilineStringLiteralOpeningDelimiter multilineInterpolatedText? multilineStringLiteralClosingDelimiter .

//interpolatedText = interpolatedTextItem interpolatedText? .
//interpolatedTextItem = "\\(" expression ")" | quotedTextItem .

//multilineInterpolatedText = multilineInterpolatedTextItem multilineInterpolatedText? .
//multilineInterpolatedTextItem = "\\(" expression ")" | multilineQuotedTextItem .

//escapeSequence = "\\" extendedStringLiteralDelimiter .
//escapedCharacter = escapeSequence "0" | escapeSequence "\\" | escapeSequence "t" | escapeSequence "n" | escapeSequence "r" | escapeSequence """ | escapeSequence "'" .
//escapedCharacter = escapeSequence "u" "{" unicodeScalarDigits "}" .
//unicodeScalarDigits = Between one and eight hexadecimal digits

//escapedNewline = escapeSequence inlineSpaces? lineBreak .





// LITERALS

// Grammar of a literal

binaryLiteral - /0b[0-1][0-1_]*/ .
//binaryLiteral = "0b" binaryDigit binaryLiteralCharacters? .
//binaryDigit = Digit 0 or 1
//binaryLiteralCharacter = binaryDigit | "_" .
//binaryLiteralCharacters = binaryLiteralCharacter binaryLiteralCharacters? .

octalLiteral - /0o[0-7][0-7_]*/ .
//octalLiteral = "0o" octalDigit octalLiteralCharacters? .
//octalDigit = Digit 0 through 7
//octalLiteralCharacter = octalDigit | "_" .
//octalLiteralCharacters = octalLiteralCharacter octalLiteralCharacters? .

decimalLiteral - /[0-9][0-9_]*/ .   // terminal (`-`, not `=`): must commit under its own name so `regexOpenSlash`'s `<-<` operand-ender list (which names `decimalLiteral`) actually matches after a number — otherwise the `@splitBefore` operator split isn't suppressed in infix position (e.g. `1/^/3` → spurious `/^`+`/3`). All other numeric literals are already `-` terminals.
//decimalLiteral = decimalDigit decimalLiteralCharacters? .
//decimalDigit = Digit 0 through 9

decimalDigits = /[0-9]+/ .
//decimalDigits = decimalDigit decimalDigits? .
//decimalLiteralCharacter = decimalDigit | "_" .
//decimalLiteralCharacters = decimalLiteralCharacter decimalLiteralCharacters? .

hexadecimalLiteral - /0x[0-9a-fA-F][0-9a-fA-F_]*/ .
//hexadecimalLiteral = "0x" hexadecimalDigit hexadecimalLiteralCharacters? .
//hexadecimalDigit = Digit 0 through 9, a through f, or A through F
//hexadecimalLiteralCharacter = hexadecimalDigit | "_" .
//hexadecimalLiteralCharacters = hexadecimalLiteralCharacter hexadecimalLiteralCharacters? .

// Grammar of a floating-point literal

// Requires a fraction OR an exponent (else a bare `1` would match, colliding with decimalLiteral):
// `1.5`, `1.5e3`, and exponent-only `1e3` all match; `1` does not. (Fixes `1e3` failing to parse.)

decimalFloatingPointLiteral     - /[0-9][0-9_]*(?:\.[0-9][0-9_]*(?:[eE][+-]?[0-9][0-9_]*)?|[eE][+-]?[0-9][0-9_]*)/ .

hexadecimalFloatingPointLiteral - /0x[0-9a-fA-F][0-9a-fA-F_]*(?:\.[0-9a-fA-F][0-9a-fA-F_]*)?(?:[pP][+-]?[0-9][0-9_]*)/ .

//floatingPointLiteral = decimalLiteral decimalFraction? decimalExponent? .
//floatingPointLiteral = hexadecimalLiteral hexadecimalFraction? hexadecimalExponent .

signedFloatingPointLiteral = [ "-" >s< ] floatingPointLiteral .

floatingPointLiteral = decimalFloatingPointLiteral | hexadecimalFloatingPointLiteral .

//decimalFraction = "." decimalLiteral .
//decimalExponent = floatingPointE sign? decimalLiteral .

//hexadecimalFraction = "." hexadecimalDigit hexadecimalLiteralCharacters? .
//hexadecimalExponent = floatingPointP sign? decimalLiteral .

//floatingPointE = "e" | "E" .
//floatingPointP = "p" | "P" .
//sign = "+" | "-" .

literal = numericLiteral | stringLiteral | regularExpressionLiteral | booleanLiteral | nilLiteral .

// Numeric maximal munch (`1.5`→float not `1`·`.5`; `0xFF`→hex not `0`·`xFF`) is handled by
// `@longest numericLiteral`, NOT by lexer-level suppression: a context-blind longest-
// across in the lexer is unsafe (Scott/Johnstone/Walsh "Multiple Lexicalisation" §2 — it broke
// availability version numbers `10.9`). Post-parse `@longest` on the BSR is the paper's SAFE
// disambiguation, and it is context-scoped for free — version/tuple digits reach `decimalDigits`,
// not `numericLiteral`, so `10.9` stays int·period·int while `1.5` collapses to the float.
// `@longest` = numeric maximal munch, done post-parse on the BSR

@longest
numericLiteral = signedIntegerLiteral | signedFloatingPointLiteral .

booleanLiteral = "true" | "false" .
nilLiteral = "nil" .

// Grammar of an integer literal

signedIntegerLiteral = [ "-" >s< ] integerLiteral .

integerLiteral = binaryLiteral .
integerLiteral = octalLiteral .
integerLiteral = decimalLiteral .
integerLiteral = hexadecimalLiteral .


// OPERATORS

// Grammar of operators

// TSPL builds operators char-by-char (operator-head operator-characters). Advent instead
// lexes each operator as ONE greedy `@lexicalClass` terminal. Deviations from TSPL (each
// faithful to swift-syntax's lexer/parser):
//
//  1. Maximal munch: `&&`, `<<`, `->`, `.../` lex as one token; a lone `&`/`<`/`.` survives
//     only where no longer operator follows.  e.g. `a && b`, not `a & (&b)`.
//  2. operatorToken @splitBefore(regexOpenSlash): an operator may end before an internal
//     regex opener so a regex can follow a prefix operator — `^^/regex/` → `^^` `/regex/`.
//     Offered only in prefix position: keyed on the terminal `regexOpenSlash`, so it inherits
//     that terminal's `<-<` = `preferRegexOverBinaryOperator` (hence operatorToken needs no
//     `<-<` of its own).  swift-syntax Cursor.swift `tryLexOperatorAsRegexLiteral` (:2275).
//  3. dotOperator (`.`-led) may CONTAIN `?`/`!` but not END in them — swift splits a trailing
//     `?`/`!` run off as postfix. So `.?.` is a binary operator but `.?`/`.!`/`.??!` are not.
//     e.g. `\Foo?.?.?.blah` = keypath `\Foo?.?` + `.?.` + `blah`.  Cursor.swift (trailing `!?` split).
//  4. postfixOperatorToken drops the `!?`-led alternatives: a prefix/postfix operator may not
//     begin with `!`/`?`.  e.g. `x!!` = two force-unwraps, never a `!!` operator.
//  5. operatorName @splitBefore(openAngle): an operator function name ends before a generic `<`.
//     e.g. `func %%%%<T,U>`.  swift-syntax SwiftParser (decl context only).
//  6. Munch-exempt single-char regex terminals — openAngle `<`, closeAngle `>`, optionalMark `?`,
//     forceMark `!`, keyPathDot `.` — match one char even inside a longer operator run, mirroring
//     swift-syntax parser-side token splitting.  e.g. `Array<Array<Int>>` (closeAngle inside `>>`),
//     `Int??` (optionalMark). keyPathDot lets a keypath `.?` pivot coexist with the `.?.` operator
//     (regex-vs-regex, neither suppresses the other; see the keypath section).

@lexicalClass @splitBefore(regexOpenSlash)
operatorToken - @builder .

@lexicalClass
dotOperator - @builder .

operator = operatorToken .
operator = dotOperator .

postfixOperatorToken - @builder .

@splitBefore(openAngle)
operatorName - @builder .

// munch-exempt single-char regex terminals
openAngle       - /</ .
closeAngle      - />/ .
optionalMark    - /\?/ .
forceMark       - /!/ .
keyPathDot      - /\./ .

//operator = operatorHead operatorCharacters? .
//operator = dotOperatorHead dotOperatorCharacters .

//operatorHead = "/" | "=" | "-" | "+" | "!" | "*" | "%" | "<" | ">" | "&" | "|" | "^" | "~" | "?" .
//operatorHead = U+00A1–U+00A7
//operatorHead = U+00A9 or U+00AB
//operatorHead = U+00AC or U+00AE
//operatorHead = U+00B0–U+00B1
//operatorHead = U+00B6, U+00BB, U+00BF, U+00D7, or U+00F7
//operatorHead = U+2016–U+2017
//operatorHead = U+2020–U+2027
//operatorHead = U+2030–U+203E
//operatorHead = U+2041–U+2053
//operatorHead = U+2055–U+205E
//operatorHead = U+2190–U+23FF
//operatorHead = U+2500–U+2775
//operatorHead = U+2794–U+2BFF
//operatorHead = U+2E00–U+2E7F
//operatorHead = U+3001–U+3003
//operatorHead = U+3008–U+3020
//operatorHead = U+3030

//operatorCharacter = operatorHead .
//operatorCharacter = U+0300–U+036F
//operatorCharacter = U+1DC0–U+1DFF
//operatorCharacter = U+20D0–U+20FF
//operatorCharacter = U+FE00–U+FE0F
//operatorCharacter = U+FE20–U+FE2F
//operatorCharacter = U+E0100–U+E01EF
//operatorCharacters = operatorCharacter operatorCharacters? .

//dotOperatorHead = "." .
//dotOperatorCharacter = "." | operatorCharacter .
//dotOperatorCharacters = dotOperatorCharacter dotOperatorCharacters? .

infixOperator = operator .
infixOperator = "&" .                    // reserved bitwise-and; bare "&" is not in the overloadable operator set

// `preferRegexOverBinaryOperator`: a leading `/` is a prefix operator ONLY when no complete regex
// lexes there. `>->( regularExpressionLiteral )` is a speculative "no regex parses here" gate (the
// predicate snapshots the RAW forest, so it sees a regex even when the enclosing parse fails). The
// resulting prune cascades via the greatest-fixpoint `pruneUnsupported`. So `_ = /x` / `_ = /E.e`
// (no closing `/`, no regex yield) keep the prefix-`/`, while `_ = /foo/ {}` (a `/foo/` regex yield
// exists) loses the `prefix-/ + foo{} + postfix-/` escape → reject (C3).
prefixOperator = >->( regularExpressionLiteral ) operator .

postfixOperator = postfixOperatorToken .   // postfix ops cannot begin with `!`/`?` (those split into force/optional)
postfixOperator = dotOperator .            // postfix ranges: `1...`, `1..<5` (dotOperator can't end in `?`/`!`, so `.?`/`.!`/`.??!` aren't postfix operators)



// TYPES

// Grammar of a type

type = functionType .
type = arrayType .
type = inlineArrayType .
type = dictionaryType .
type = typeIdentifier .
type = tupleType .
type = optionalType .
type = implicitlyUnwrappedOptionalType .
type = protocolCompositionType .
type = opaqueType .
type = boxedProtocolType .
type = @prefer metatypeType .   // @prefer over typeIdentifier: `A.Type`/`A.Protocol` are ALWAYS a metatype (probe: swift-syntax yields MetatypeType, never a member-type named `Type`/`Protocol`), so prefer the metatype reading where both match the same span.
type = anyType .
// `Self` as a type is reached via typeIdentifier (typeName = selfType), mirroring swift-syntax's
// parseTypeIdentifier (Self ∈ IdentifierTypeSyntax.NameOptions). A separate `type = selfType`
// would duplicate that path and make bare `Self` ambiguous in type position, so it's omitted.
// (`Any` differs: swift-syntax parses it via the special parseAnyType, not as an identifier type,
// so `type = anyType` above is the single correct path and `Any` is intentionally not a typeName.)
type = "(" tupleTypeElement ")" .   // TODO: swift-syntax: (T) parses as TupleTypeSyntax with one element; using tupleTypeElement here brings in parameterModifiers? support, so (sending T), (label: T), (label: sending T) all parse.
type = "~" type . // TODO: SE-0390 suppressed/inverse type — swift-syntax parseSimpleType (Types.swift:194-212) RawSuppressedTypeSyntax
// Type-position specifier / attribute prefix — the SINGLE source of truth (swift-syntax
// parseTypeSpecifierList + parseTypeAttributeList, Types.swift:38/747). Applies to ANY type;
// parameter/annotation/result positions delegate here rather than carrying their own slot, so
// a specifier is never parsed twice (no duplicate derivations). `parameterModifier` already
// encodes the full specifier set (inout/borrowing/consuming/sending/isolated/_const/__shared/
// __owned/nonisolated[(nonsending)]/dependsOn(...)).
type = parameterModifier type .
type = attribute type .
// Bare `nonisolated` type specifier binds a FUNCTION type only (SE-0461): `let x: nonisolated
// (Int) async -> Void`. swift-syntax rejects bare `nonisolated` on a same-line `(` and treats
// `nonisolated⏎(hello)` as two statements (probe: hasError). Restricting the operand to
// `functionType` (which requires `->`) reproduces both: #17 binds the arrow type, while `(hello)`
// (no `->`) can't bind, leaving `nonisolated` a bare typeIdentifier + a separate `(hello)` statement
// — resolving the residual `let x: nonisolated⏎(hello)` ambiguity. The `nonisolated(nonsending)`
// arg form stays on parameterModifier (type = parameterModifier type, above).
type = "nonisolated" functionType .

// Grammar of a type annotation

typeAnnotation = ":" type .   // specifiers/attributes carried by `type` (single source of truth)


// Grammar of a type identifier
// swift-syntax canParseTypeIdentifier (Types.swift:1041): base name + optional generic args, dotted.

typeIdentifier = typeName typeGenericArgumentClause? | typeName typeGenericArgumentClause? "." typeIdentifier .
typeName = hardIdentifier .
typeName = selfType .           // TODO: verify fix for https://github.com/swiftlang/swift-book/issues/293
// SE-0491: a module-qualified type name. After `::` swift-syntax consumes ANY keyword as the name
// (Names.swift:218), so the name is `identifier` (the raw identifier-shaped token, keyword
// exclusion NOT applied). Covers `Swift::Type`, `Swift::Self`, `Swift::Any`, member `Type.Module::M`,
// and attribute names via typeIdentifier.
typeName = moduleSelector identifier ---( "_" ) .

// Grammar of a tuple type

tupleType = "(" ")" | "(" tupleTypeElement "," tupleTypeElementList ","? ")" .   // SE-0470 trailing comma
tupleTypeElementList = tupleTypeElement | tupleTypeElement "," tupleTypeElementList .

tupleTypeElement = elementName typeAnnotation | type .  // element specifiers carried by `type`
elementName = hardIdentifier | "_" .   // `_` = wildcard tuple-type label, e.g. `(_: Int, y: Int)` (swiftc -parse accepts; single label only — two labels is a tuple-type error)

// Leading attributes on a function type are carried by `type = attribute type`
// (swift-syntax always nests `AttributedTypeSyntax > FunctionTypeSyntax`), so functionType
// itself takes no `attributes?` — that path was a same-span redundant reading.

// Grammar of a function type

functionType = functionTypeArgumentClause "async"? throwsClause? "->" type .

functionTypeArgumentClause = "(" ")" .
functionTypeArgumentClause = "(" functionTypeArgumentList "..."? ","? ")" .   // SE-0470 trailing comma

functionTypeArgumentList = functionTypeArgument | functionTypeArgument "," functionTypeArgumentList .
//functionTypeArgument = attributes? parameterModifier? type | argumentLabel typeAnnotation .
functionTypeArgument = type | externalArgumentLabel? localArgumentLabel typeAnnotation . // specifiers/attributes carried by `type`

//argumentLabel = softIdentifier .
externalArgumentLabel = softIdentifier | "_" .  // accept all keywords except let, var, inout; `_` = wildcard name in function-type params
localArgumentLabel = softIdentifier | "_" .     // but references to the parameter in the function body must use backticks

throwsClause = "throws" | "throws" "(" type ")" .

// Grammar of an array type

arrayType = "[" type "]" .

// SE-0453 InlineArray sugar `[count of element]`. swift-syntax parseInlineArrayType
// (Types.swift:699): both count and element are generic-argument positions (a type or
// a value literal), `of` is a contextual keyword. `genericArgument = type | signedIntegerLiteral`.
inlineArrayType = "[" genericArgument "of" genericArgument "]" .

// Grammar of a dictionary type

dictionaryType = "[" type ":" type "]" .

// `?` / `!` / `.Type` / `.Protocol` are TIGHT POSTFIXES on a SIMPLE type — named after
// swift-syntax's parseSimpleType (Parser/Types.swift), whose postfix loop is exactly this —
// NOT on arbitrary types: `inout Int?` = inout(Int?) (specifier wraps the optional),
// `() -> Element?` = optional RETURN (a function type is never directly optional — needs
// parens: `(() -> E)?`), `~A?` = ~(A?), `some P?` = some(P?). `simpleType` is the subset these
// postfixes may bind to; prefix forms (~/modifier/attribute), functionType, compositions and
// some/any operands are excluded.
// swift-syntax canParseSimpleType (Types.swift:861): the non-composition, non-function type core.
simpleType = typeIdentifier | tupleType | arrayType | inlineArrayType | dictionaryType
           | optionalType | implicitlyUnwrappedOptionalType | metatypeType | anyType
           | "(" tupleTypeElement ")" .

// Grammar of an optional type

optionalType = simpleType >s< optionalMark .                          // disallow space before '?'

// Grammar of an implicitly unwrapped optional type

implicitlyUnwrappedOptionalType = simpleType >s< forceMark .       // disallow space before '!'

// swift-syntax composition elements are full parseSimpleType (Types.swift:129,157), which includes
// Any and Self. We allow typeIdentifier | anyType | selfType — the realistic composition elements;
// tuple/array/etc. are syntactically accepted by swift-syntax but compiler-rejected and would add
// GLL ambiguity, so they're omitted.

// Grammar of a protocol composition type

protocolCompositionType = protocolCompositionElement "&" protocolCompositionContinuation .
protocolCompositionContinuation = protocolCompositionElement | protocolCompositionType .
protocolCompositionElement = typeIdentifier | anyType .   // `Self` is already a typeIdentifier (typeName = selfType)

// Grammar of an opaque type

opaqueType = "some" type .

// Grammar of a boxed protocol type

boxedProtocolType = "any" type .

// Grammar of a metatype type

metatypeType = simpleType "." "Type" | simpleType "." "Protocol" .   // metatype suffix is a simple-type postfix (see simpleType above)

// Grammar of an Any type

anyType = "Any" .

// Grammar of a Self type

selfType = "Self" .

// Grammar of a type inheritance clause

typeInheritanceClause = ":" typeInheritanceList .
//typeInheritanceList = attributes? "~"? typeIdentifier | attributes? "~"? typeIdentifier "," typeInheritanceList .
typeInheritanceList = attributes? "~"? "nonisolated"? typeIdentifier
                    | attributes? "~"? "nonisolated"? typeIdentifier "," typeInheritanceList .
// SE-0414 nonisolated conformance is BARE only — swift-syntax rejects `struct S: nonisolated(unsafe) P` (probe: hasError). The `(arg)` form belongs to the decl modifier / type specifier, not conformance.

// EBNF:
//typeInheritanceClause = ":" typeInheritance { "," typeInheritance } .
//typeInheritance = attributes? "~"? "nonisolated"? typeIdentifier .

// EXPRESSIONS

// Grammar of an expression

// if/switch expressions may have at most one "as"/"as?"/"as!" coercion but not "is" or any other
// infix operator. Mirrors swift-syntax's parseSingleValueStmt path.

expression = tryOperator? awaitOperator? conditionalExpression coercingOperator? .
expression = tryOperator? awaitOperator? prefixExpression infixExpressions? .

// `@shortest [ … ]` the optional prefix operator: at expression-start `/abc/` parses both as a
// regex literal (operator skipped) AND as prefix-`/`(postfix-`/`(abc)) (operator taken);
// avoiding the operator makes the regex reading win = swift-syntax's
// `preferRegexOverBinaryOperator` (Tool 4). Where skipping fails (`-x`), phase-1 drops it
// and the operator is taken as normal. `@avoid` is the follower-pivot optional-skip (keep
// the smallest pivot on postfixExpression); it is NOT `@shortest` — extent on the OPT
// over-prunes here and rejects valid input (`!!/1 / .bitWidth`, `(^/x)/`). See Oracle.md.
// `@longest`: prefer the longest operand (swift-syntax canParseSimpleOrCompositionType,
// Types.swift:841 — greedily consumes the `&`-composition). Resolves `any P & Q` in expression
// position — `any` binds the whole composition (`any (P & Q)`, probe-verified: CompositionType, no infix `&`),
// not `(any P) & Q`. The two readings give prefixExpression different extents at the same start;
// keep the longest. Only fires where an operand genuinely has multiple extents (any/some + `&`
// composition); ordinary operands are single-extent so it's a no-op elsewhere.

// Grammar of a prefix expression

@longest
prefixExpression = @shortest [ prefixOperator >s< ] postfixExpression .   // >s<: a prefix operator is rightBound (tight to its operand) — `/ 1` (space after) is NOT prefix, so a line-leading spaced operator can't begin a statement; it stays infix, continuing the previous line (`0⏎/ 1 /⏎2` = one `0 / 1 / 2`, not a split)
prefixExpression = "!" >s< postfixExpression .
prefixExpression = inOutExpression .
// SE-0366 (consume), SE-0432 (borrow), SE-0429 (copy), SE-0411 (unsafe)
// contextual-keyword prefix operators. swift-syntax Expressions.swift:483-558
// parses these in parseUnaryExpression as contextual-keyword prefixes on a
// sequence-expression-element (recursive). We recurse on prefixExpression —
// simpler than expression-level placement and still covers `consume try` /
// `borrow try` indirectly via GLL exploration.
// `<s> >n<` mirrors swift-syntax's two-rule check:
//   <s>  — non-empty trivia gap → rejects `borrow(msg)` (Statements.swift:993).
//   >n<  — no newline in gap    → rejects `borrow\nmsg` (Statements.swift:911).
// `@prefer`: where BOTH the keyword and the identifier reading parse a spaced operand
// (`unsafe ()`, `unsafe []`, `unsafe .lock` — spaced call/subscript/member on an identifier
// named `unsafe` are also grammatical), swift-syntax picks the KEYWORD expression
// (probe: UnsafeExpr, not FunctionCall/Subscript/MemberAccess). Tight forms (`unsafe(1)`)
// don't enter the keyword rule at all (<s>), so the call reading survives unchallenged.
prefixExpression = @prefer "consume" <s> >n< prefixExpression .
prefixExpression = @prefer "borrow"  <s> >n< prefixExpression .
prefixExpression = @prefer "copy"    <s> >n< prefixExpression .
prefixExpression = @prefer "unsafe"  <s> >n< prefixExpression .

// Grammar of an in-out expression

inOutExpression = "&" >s< postfixExpression .
// >s<: inout `&` is rightBound (tight to operand) — `&x` is inout, `& x` (spaced) is an error in swift-syntax (probe-verified)
// `a & b`/`yield & 5` stay binary. operand is an lvalue: `&x`, `&y[0]`, `&obj.prop`

// Grammar of a try expression

tryOperator = "try" | "try" >s< "?" | "try" >s< "!" .

// Grammar of an await expression

awaitOperator = "await" .

// Whitespace-symmetric infix (swift-syntax classifyOperatorToken: infix ⟺ leftBound==rightBound).
// The leading `>s<`/`<s>` checks the gap BEFORE the operator (= gap after the left operand);
// the second checks the gap after. Both-tight (`a+b`) or both-loose (`a + b`, incl. `a +⏎b`)
// are infix; asymmetric (`a +b`, `a+ b`, `a⏎-b`) match neither, so the operator is forced
// prefix/postfix — killing the newline-vs-continuation ambiguity. See TODO #22.
// `@longest`: a `typeCastingOperator` (`as`/`as?`/`as!`/`is` + type) whose type has two valid
// extents (`as ()` vs `as () -> ()`; the empty-tuple type vs the function type `() -> ()`) is an
// EXTENT choice — swift-syntax takes the LONGEST cast type (the whole `() -> ()`), leaving no
// spurious `-> ()` tail to re-parse as infix. Same shape as `@longest genericIdentifier` (`A` vs
// `A<B>`). No-op for ordinary operator chains: each infixExpression is one operator + one operand,
// so it has a single extent and shares no start with a longer sibling.

// Grammar of an infix expression

@longest
infixExpression = >s< infixOperator >s< tryOperator? awaitOperator? prefixExpression .
infixExpression = <s> infixOperator <s> tryOperator? awaitOperator? prefixExpression .
infixExpression = assignmentOperator expression .     // RHS may be an if/switch expression. NO explicit try/await here: `expression` already begins with `tryOperator? awaitOperator?`, so repeating them made `= try foo()+bar()` attach `try` two ways (ambiguous pivot — testTry*/testAsync15).
infixExpression = conditionalOperator expression .     // false-branch of ternary may be an if/switch expression (try/await via `expression`)
infixExpression = typeCastingOperator .
infixExpressions = infixExpression infixExpressions? .

// conditionExpression: like expression but without assignmentOperator — assignment returns Void and
// is never valid as a boolean condition (if/while/guard condition lists, repeat-while, where clauses).
@longest
conditionInfixExpression = >s< infixOperator >s< tryOperator? awaitOperator? prefixExpression .
conditionInfixExpression = <s> infixOperator <s> tryOperator? awaitOperator? prefixExpression .
conditionInfixExpression = conditionalOperator tryOperator? awaitOperator? expression .     // false-branch of ternary may be an if/switch expression
conditionInfixExpression = typeCastingOperator .
conditionInfixExpressions = conditionInfixExpression conditionInfixExpressions? .

conditionExpression = tryOperator? awaitOperator? conditionalExpression coercingOperator? .
conditionExpression = tryOperator? awaitOperator? prefixExpression conditionInfixExpressions? .

// Grammar of an assignment operator

assignmentOperator = <s> "=" <s>
                   | >s< "=" >s< .

// Grammar of a conditional operator

conditionalOperator = <s> "?" expression ":" .      // <s> before `?` only: swift-syntax requires whitespace (space OR newline) BEFORE the ternary `?` — a tight `a?`/`a? ` is postfix optional-chaining, not ternary (probe: `a?b:c`,`a? b:c` error). The char AFTER `?` is free: `a ?b : c` is a valid ternary, so no `<s>` there.

// Grammar of a type-casting operator

typeCastingOperator = "is" type .
typeCastingOperator = "as" type .
typeCastingOperator = "as" >s< "?" type .
typeCastingOperator = "as" >s< "!" type .

// "as"/"as?"/"as!" only — used after if/switch expressions where "is" is disallowed
coercingOperator = "as" type .
coercingOperator = "as" >s< "?" type .
coercingOperator = "as" >s< "!" type .

// Grammar of a primary expression

primaryExpression = genericIdentifier .
// `@longest`: `A<B>` (identifier + genericArgumentClause) vs bare `A` is an EXTENT choice — keep the
// longer generic form. (Was `@prefer identifier genericArgumentClause`, a prefer-longer misuse of
// the now-same-span @prefer.) Where no `<…>` follows, only the bare identifier parses, so @longest
// is a no-op.
@longest
genericIdentifier = hardIdentifier | hardIdentifier genericArgumentClause .
// TODO: does @longest work on optional?  e.g. @longest genericIdentifier = hardIdentifier genericArgumentClause? .

// SE-0491 module-qualified reference. After `::` any keyword is a name (Names.swift:218), so the
// qualified name is `identifier` (covers Swift::foo, Swift::nil, Swift::self, Swift::Self,
// Swift::Any, Swift::super, Swift::init, Swift::do, …). Subsumes `moduleSelector identifier`.
primaryExpression = moduleGenericIdentifier .
@longest
moduleGenericIdentifier = moduleSelector identifier ---( "_" )
                        | moduleSelector identifier ---( "_" ) genericArgumentClause .
// `$foo` (property-wrapper projection) lexes as `.identifier` in swift-syntax (Cursor.swift:2343-2346),
// so it's a valid qualified name too: `Swift::$foo`.
primaryExpression = moduleSelector propertyWrapperProjection .
// swift-syntax parseIdentifierExpression (Expressions.swift:1436) uses `.compoundNames`: a bare
// identifier reference can carry an argument-label list, e.g. `greet(name:)` — an unapplied
// reference to a function by its full compound name. The labels are part of the name, distinct
// from a call `greet(name: x)`. swift-syntax disambiguates via `canParseArgumentLabelList` lookahead.
primaryExpression = hardIdentifier "(" argumentNames ")" .
// swift-syntax parseAnonymousClosureArgument (Expressions.swift:1348-1349): `.dollarIdentifier`
// ($0/$1/…) is a distinct primary-expression form representing an implicit closure parameter,
// not a generic identifier reference.
primaryExpression = implicitParameterName .
primaryExpression = literalExpression .
primaryExpression = selfExpression .
primaryExpression = superclassExpression .
primaryExpression = closureExpression .
primaryExpression = @prefer parenthesizedExpression .   // @prefer over `"(" functionType ")"` (below): a simple parenthesized arrow `(() -> A)` matches both; swift-syntax's faithful shape is the sequence route (TupleExpr(SequenceExpr), never FunctionType-in-expr), so prefer it. Start-keyed prune fires only where parenthesizedExpression also yields — i.e. the arrow overlap; the functionType route survives for inout/throws/async arrows it can't reach.
primaryExpression = tupleExpression .
primaryExpression = implicitMemberExpression .
primaryExpression = wildcardExpression .
primaryExpression = macroExpansionExpression .   // also covers #selector(…), #keyPath(…), #colorLiteral(…): swift-syntax parses these as MacroExpansionExpr, not dedicated nodes (probe-verified)
primaryExpression = keyPathExpression .
primaryExpression = selfType .                          // TODO: quick fix similar to https://github.com/swiftlang/swift-book/issues/293
// swift-syntax parsePrimaryExpression `.Any` case (Expressions.swift:1346): bare `Any` in
// expression position is a type-expr, enabling `Any.self`, `Any.Type`, etc.
primaryExpression = anyType .
primaryExpression = "(" moduleSelector? operator ")" .  // operator-as-value reference, e.g. (/), (+), (Swift::+) per SE-0491
// Single `attribute` (not `attributes`): a multi-attribute run (`[@isolated(any) @convention(swift) () -> ()]()`)
// nests via `type = attribute type`, so an `attributes` list here would only duplicate every split
// point of the run (the attributes⟨pivot⟩type ambiguity). One reading: @first (attribute) → type carries the rest.
primaryExpression = attribute type .
// swift-syntax parsePrimaryExpression `any` case (Expressions.swift:580-586): when the
// current token is `any` and the lookahead suggests a type-prefixed expression, the
// whole `any T` is parsed via parseType and wrapped in RawTypeExprSyntax.
primaryExpression = boxedProtocolType .
// Parenthesized function type as a metatype base, e.g. `((inout Int) -> Void).self`,
// `(() throws -> A).self`. swift-syntax models these as TupleExpr(SequenceExpr) with the pieces
// as expressions/type-exprs, but our expression grammar can't reach the type-only pieces
// (`inout`/parameter-modifier args, `throws`/`async` arrows), so this rule is the sole route for
// them. For SIMPLE arrows (`(() -> A)`) the parenthesizedExpression + `->`-operator route ALSO
// matches — that overlap is resolved by @prefer on parenthesizedExpression (above).
primaryExpression = "(" functionType ")" .

// All primaryExpression alternatives except literalExpression — used to build nonLiteralPostfix (B1 fix).
// Keeps the @prefer on parenthesizedExpression so the (…)-vs-functionType disambiguation still fires.
nonLiteralPrimary = genericIdentifier | moduleGenericIdentifier | moduleSelector propertyWrapperProjection
                  | hardIdentifier "(" argumentNames ")" | implicitParameterName
                  | selfExpression | superclassExpression | closureExpression
                  | @prefer parenthesizedExpression | tupleExpression | implicitMemberExpression
                  | wildcardExpression | macroExpansionExpression | keyPathExpression
                  | selfType | anyType | "(" moduleSelector? operator ")"
                  | attribute type | boxedProtocolType | "(" functionType ")" .

// Grammar of a literal expression

literalExpression = literal | arrayLiteral | dictionaryLiteral .

arrayLiteral = "[" arrayLiteralItems? ","? "]" .
arrayLiteralItems = arrayLiteralItem | arrayLiteralItem "," arrayLiteralItems .

arrayLiteralItem = @prefer expression .   // @prefer over `typeExpression` (below): swift-syntax parses an arrow element `(Int,Double) -> Bool` as a SequenceExpr(TupleExpr, `->`, …) — NOT a FunctionType/TypeExpr (probe-verified). The expression/`->`-operator route is faithful; typeExpression survives only for type-only elements the expression route can't reach.
// TypeExpr array element (swift-syntax `TypeExprSyntax`). A collection element that is a
// TYPE the expression route can't produce — a specifier/attribute-prefixed or arrow function
// type (`[() throws -> T]`, `[nonisolated(nonsending) () async -> Void]`, `[@escaping () -> Void]`),
// or an optional/paren'd type thereof (`[(… )?]`). swift-syntax parses these as an array_expr
// whose element is a type_expr (probe: `swiftc -dump-parse`). `@prefer expression` above keeps the
// literal reading for `[Int]`/`[X & Y]` where both parse; the type reading survives only where
// the expression route fails.
arrayLiteralItem = typeExpression .
typeExpression = type .   // swift-syntax TypeExprSyntax: a type used in expression position

dictionaryLiteral = "[" dictionaryLiteralItems ","? "]" | "[" ":" "]" .
dictionaryLiteralItems = dictionaryLiteralItem | dictionaryLiteralItem "," dictionaryLiteralItems .
dictionaryLiteralItem = dictionaryLiteralElement ":" dictionaryLiteralElement .
dictionaryLiteralElement = @prefer expression .   // @prefer over typeExpression, same rationale as arrayLiteralItem
dictionaryLiteralElement = typeExpression .        // TypeExpr key/value, e.g. `[String: (nonisolated(nonsending) () async -> Void)?]`

// playgroundLiteral rules removed: swift-syntax has no object-literal node — `#colorLiteral(…)`,
// `#fileLiteral(…)`, `#imageLiteral(…)` are plain MacroExpansionExpr (probe-verified)

// Grammar of a self expression

selfExpression = "self" .   // self is a bare reference; self.foo / self[i] / self.init go through explicitMember/subscript (swift-syntax: DeclReferenceExpr + MemberAccess/SubscriptCall)

// `super` is likewise a bare primary (swift-syntax SuperExpr): super.foo / super.init / super[i]
// attach via the normal postfix machinery (explicitMemberExpression / subscriptExpression), the
// same as self. The TSPL-style superclassMethod/Subscript/Initializer productions duplicated
// those suffixes and made `super.init` ambiguous (softIdentifier also matches `init`).

// Grammar of a superclass expression

superclassExpression = "super" .

// Grammar of a conditional expression

conditionalExpression = ifExpression | switchExpression .

// swift-syntax models `if`/`switch` as EXPRESSIONS everywhere (IfExprSyntax/SwitchExprSyntax);
// at statement position they surface as ExpressionStmt(IfExpr/SwitchExpr) — verified by probe
// across bare/else-less/if-case/labeled/value positions. There is no separate IfStmt/SwitchStmt.
// So the full else-optional, codeBlock-bodied shape lives here (formerly duplicated as
// ifStatement/switchStatement); `statement = expression` carries them at statement position,
// and branchStatement keeps only `guard` (a real GuardStmt).

// Grammar of an if expression

// `>-> ( "{" )` (B2 discriminator 2): a condition may never open with `{` — a leading brace is the
// statement body, so `if {x}() {}` is a reject (swift-syntax: condition = MissingExpr). See REJECTS §B2.
ifExpression = "if" >-> ( "{" ) conditionList codeBlock elseClause? .
elseClause = "else" codeBlock | "else" ifExpression .

// Grammar of a switch expression

switchExpression = "switch" >-> ( "{" ) expression "{" switchCases? "}" .   // B2 discriminator 2: subject may not open with `{` (`switch { 42 } {…}` is a reject)

// Grammar of a closure expression

// Partitioned by the open-brace layout so the two readings are DISJOINT (no ambiguity): `>n<`
// = no newline after `{` (tight), `<n>` = newline after `{`. B2 disc-1: a newline-opened trailing
// closure inside a condition is NOT a trailing closure (the `{` is the body) — `@excludedFrom`
// prunes that reading where it is contained in BOTH a `conditionExpression` and a `trailingClosures`.
// The `<n>` fires at PARSE time (a normal alternate); the Oracle only does the containment BSR query.
closureExpression = "{" >n< closureSignature? statements? "}" .
closureExpression = @excludedFrom(conditionExpression) @excludedFrom(trailingClosures) newlineOpenedClosure .
newlineOpenedClosure = "{" <n> closureSignature? statements? "}" .

// swift-syntax ClosureSignatureSyntax carries `attributes` INSIDE the signature (before the
// optional capture clause), and a signature always ends in `in`. So closure attributes require
// an `in` — `{ @Sendable in x }` is valid, `{ @Sendable x }` is not. Attributes therefore live
// here, not as a standalone `attributes?` on closureExpression.
closureSignature = attributes? captureList? closureParameterClause "async"? throwsClause? functionResult? "in" .
closureSignature = attributes? captureList "in" .
closureSignature = attributes "in" .

closureParameterClause = "(" ")" | "(" closureParameterList ","? ")" | identifierList .
closureParameterList = closureParameter | closureParameter "," closureParameterList .

//closureParameter = attributes? closureParameterName typeAnnotation? .
//closureParameter = attributes? closureParameterName typeAnnotation "..." .
// swift-syntax parseClosureParameter (Parameters.swift:194-200) uses parseParameterNames
// which returns two names (firstName / secondName) — same `external? internal: Type` shape
// as regular parameters. `_ x: Type` and `x y: Type` are both valid.
// `@shortest [ … ]`: modifier-word + one name = external name, not a modifier (see `parameter` below).
// closureParameterNames groups the one-or-two names so the @avoid follower has a common end.
closureParameter = attributes? @shortest [ parameterDeclarationModifiers ] closureParameterNames typeAnnotation? .
closureParameter = attributes? @shortest [ parameterDeclarationModifiers ] closureParameterNames typeAnnotation "..." .
closureParameterNames = externalParameterName closureParameterName | closureParameterName .
closureParameterName = hardIdentifier | "_" .       // `_` = wildcard closure param (e.g. `{ _ in }`, `{ (_ x: Int) in }`)

captureList = "[" "]" .   // explicit empty capture clause `{ [] in … }` (swift-syntax parseClosureCaptureClause allows an empty list)
captureList = "[" captureListItems ","? "]" .
captureListItems = captureListItem | captureListItem "," captureListItems .
captureListItem = captureSpecifier? hardIdentifier .
captureListItem = captureSpecifier? hardIdentifier assignmentOperator expression .
captureListItem = captureSpecifier? selfExpression .
captureSpecifier = "weak" | "unowned" | "unowned" "(" "safe" ")" | "unowned" "(" "unsafe" ")" . // no >s<: swift-syntax accepts `unowned (safe)`/`unowned (unsafe)` with a space (probe: hasError=false). Only type specifiers and @attribute arg clauses require a tight `(`.

// Grammar of an implicit member expression

implicitMemberExpression = "." moduleSelector? softIdentifier .          // allows e.g. '.public', '.Swift::min' (SE-0491)
implicitMemberExpression = "." moduleSelector? softIdentifier "." postfixExpression .

// Grammar of a parenthesized expression

parenthesizedExpression = "(" expression ")" .

// Grammar of a tuple expression

tupleExpression = "(" ")" | "(" tupleElement "," tupleElementList ","? ")" .
tupleElementList = tupleElement | tupleElement "," tupleElementList .
tupleElement = expression | softIdentifier ":" expression .

// Grammar of a wildcard expression

wildcardExpression = "_" .


// Grammar of a macro-expansion expression

// `@longest`: a macro greedily takes its (single) argument clause. `#foo(bar)` is macro-with-args,
// not argless-`#foo` + call `(bar)` (probe-verified: swift-syntax yields MacroExpansionExpr with
// args, even when spaced `#foo (bar)`; `#foo(1)(2)` = macro `#foo(1)` then a call `(2)`). The two
// readings give macroExpansionExpression different extents at the same start; keep the longest.
@longest
macroExpansionExpression = macroHead genericArgumentClause? functionCallArgumentClause? trailingClosures? .
//macroExpansionExpression = "#" identifier genericArgumentClause? functionCallArgumentClause? trailingClosures? .


// Grammar of a key-path expression

//keyPathExpression = "\" type? "." keyPathComponents .
//keyPathComponents = keyPathComponent | keyPathComponent "." keyPathComponents .
//keyPathComponent = identifier keyPathPostfixes? | keyPathPostfixes .

//keyPathPostfixes = keyPathPostfix keyPathPostfixes? .
//keyPathPostfix = "?" | "!" | "self" | "[" functionCallArgumentList "]" .

// swift-syntax parseKeyPathExpression (Expressions.swift:1107+). Deviations from the TSPL
// grammar above (each faithful to swift-syntax):
//
//  1. Root = parseSimpleType(allowMemberTypes:false) (Expressions.swift:1118): the root is a
//     SIMPLE type with the `.member` chain excluded, so `\a.b.c` = root `a` + `.b` `.c` (the
//     root is never a member chain — kills the root-vs-`.member` overlap structurally, no
//     `@shortest`). Covers `\Foo<Int>.bar`, `\[X].y`, `\(X).y`, `\Any.y`.
//  2. Root greedily absorbs trailing `?`/`!` (parseSimpleType loop, Types.swift:327-333):
//     `\X?.y` = root `X?` + `.y`. So a LEADING `?`/`!` is never a component (keyPathPivotFirst
//     excludes bare `?`/`!`).
//  3. A leading `[…]` root type is preferred over a bare-subscript first component (@prefer):
//     `\[X].y` = root ArrayType; `\[0].y` → subscript (`0` is no type, so the type reading
//     fails and the preference is inert).
//  4. mayBeAfterTypeName (Expressions.swift:1129): the DOTTED forms `.?`/`.!`/`.[` are valid
//     only while every preceding component is a property; the first non-property flips the flag
//     false FOREVER, after which only BARE `?`/`!`/`[…]` and `.member` are allowed. A CFG can't
//     thread the flag, so it is two nonterminals — flag-true (keyPathComponents /
//     keyPathComponentsAfterProperty) vs flag-false (keyPathBareTail). An EBNF collapse of these
//     is non-confluent (see the note at the rules); the recursion is load-bearing.
//     e.g. `\Optional.?!?!?!?` accepts, `\Optional.?!?!?!?.??!` rejects.
//  5. @longest: a keypath greedily consumes ALL components — `\.?.foo` is one keypath, not
//     `\.?` + a `.foo` member access.
//  6. KNOWN GAP (REJECTS.md C1, testKeyPathSubscript#2 disabled): the greedy-keypath COMMIT is
//     not modeled, so `\Foo.Bar.?.[1]` is wrongly accepted (Advent also finds `\Foo.Bar` +
//     `.?.` + `[1]`, which nothing prunes). Needs a keypath-commit / structural-lookahead primitive.

// Must be two TOP-LEVEL alternates: @prefer/@longest are keyed on the nonterminal's own
// alternates (nt.alt), so the root-vs-bare-subscript preference (dev 3) only binds here.
// Factoring the shared "\\" into an inline `( … | … )` group puts @prefer inside the group
// where the Oracle can't see it — it goes inert and ambiguity explodes (1 → 40, measured).
// TODO: is the argument above still valid ('goes inert')?

@longest
keyPathExpression = @prefer "\\" keyPathRootType keyPathComponents? .   // components optional (`\Foo`, `\X?`).
// TODO: why do we need @prefer here if the alternate always starts with a '.', and this one can't?F
@longest
keyPathExpression =         "\\" keyPathComponents .                    // root-absent (`\.foo`): keyPathComponents must start with `.`

keyPathRootType = keyPathRootBase keyPathRootOptionals? .   // dev 1,2
keyPathRootBase = typeName typeGenericArgumentClause?
                | tupleType
                | arrayType
                | inlineArrayType
                | dictionaryType
                | anyType
                | "(" tupleTypeElement ")" .
keyPathRootOptionals = keyPathRootOptional keyPathRootOptionals? .
keyPathRootOptional = >s< optionalMark .                       // dev 2: tight postfix `?` (Types.swift:327)
keyPathRootOptional = >s< forceMark .                          // dev 2: tight postfix `!` (Types.swift:331)

// dev 4 — flag-true run (dotted forms allowed) vs flag-false tail (bare only), as explicit
// nonterminals. NOTE: an EBNF collapse — `keyPathComponents = { property } [ pivot { bare } ]` —
// reads shorter but is NON-CONFLUENT: it makes the component bracketing ambiguous and
// residual-ambiguity jumps 1 → ~40 across the keypath tests (seed-dependent; measured). The
// right-recursive nonterminals below are load-bearing for disambiguation, not just verbosity.
// Entry pivot (0 properties) = keyPathPivotFirst — no bare `?`/`!`: the root absorbed trailing
// `?`/`!` (dev 2), and excluding them keeps `\Foo?` unambiguous. After ≥1 property, keyPathPivot
// re-admits bare `?`/`!` (`\Foo.bar?`). The bare tail has no dotted `.?`/`.!`/`.[`.
keyPathComponents = keyPathProperty keyPathComponentsAfterProperty? .   // leading property run
keyPathComponents = keyPathPivotFirst keyPathBareTail? .                // first non-property → flag false

keyPathComponentsAfterProperty = keyPathProperty keyPathComponentsAfterProperty? .   // flag stays true
keyPathComponentsAfterProperty = keyPathPivot keyPathBareTail? .                     // non-property → flag false

keyPathProperty = "." keyPathMemberName .

keyPathPivotFirst = keyPathDot >s< optionalMark .              // .?  (keyPathDot per operator dev 6)
keyPathPivotFirst = keyPathDot >s< forceMark .                 // .!
keyPathPivotFirst = "." "[" functionCallArgumentList? "]" .     // .[args]
keyPathPivotFirst = "[" functionCallArgumentList? "]" .         // bare [args]  (`\[0].y`, `\Foo[0]`)
keyPathPivot = keyPathPivotFirst .
keyPathPivot = >s< optionalMark .                              // bare ?  (`\Foo.bar?`; dev 2: re-admitted after a property)
keyPathPivot = >s< forceMark .                                 // bare !

keyPathBareTail = keyPathBareComponent keyPathBareTail? .      // flag false: no dotted `.?`/`.!`/`.[`
keyPathBareComponent = keyPathProperty .                        // .member
keyPathBareComponent = >s< optionalMark .                       // bare ?
keyPathBareComponent = >s< forceMark .                          // bare !
keyPathBareComponent = "[" functionCallArgumentList? "]" .      // bare [args]

// Member name accepts any identifier (so keywords like `extension`/`self` work), integer indices
// for tuple-typed paths, and the decl-name argument-label syntax (.method(_:), .method(label:), .method(a:b:))
// which is swift-syntax's parseDottedExpressionSuffix function-reference form — NOT the experimental
// keypathWithMethodMembers method-call form (that one stays out).
keyPathMemberName = moduleSelector? softIdentifier .                                 // softIdentifier (not raw identifier): with the optional moduleSelector? prefix, bare raw identifier fails to consume a keyword member (`.self`/`.extension`/…) — a Schrödinger/OPT interaction — whereas the `---`-annotated softIdentifier resolves it, matching every other member rule. SE-0491: .Module::member
keyPathMemberName = decimalDigits .
keyPathMemberName = moduleSelector? softIdentifier "(" keyPathArgumentLabels ")" .    // .method(_:) / .method(arg:) / .method(a:b:)
keyPathArgumentLabels = keyPathArgumentLabel keyPathArgumentLabels? .
keyPathArgumentLabel = identifier ---( "inout" "_" ) ":" .   // swift-syntax isArgumentLabel (Names.swift:410): a label is an identifier or ANY keyword EXCEPT `inout`, or `_`. Exclude `inout` (per that rule) and `_` (the wildcard label is the separate production below; without excluding it here `.method(_:)` is ambiguous).
keyPathArgumentLabel = "_" ":" .

// selectorExpression / keyPathStringExpression removed: `#selector(…)` and `#keyPath(…)` are
// MacroExpansionExpr in swift-syntax (probe-verified), covered by macroExpansionExpression.

// Grammar of a postfix expression

postfixExpression = primaryExpression .
// A postfix operator is left-bound: tight to its operand, no preceding whitespace
// (swift-syntax `classifyOperatorToken`: postfix ⟺ leftBound && !rightBound). `>s<`
// forbids a space before the operator, so a spaced operator (`repr == .none`, `P & Q`)
// cannot be eaten as postfix and is left for infixExpression to classify.
// Postfix operator ⟺ leftBound && !rightBound (swift-syntax classifyOperatorToken). `>s<` before = leftBound.
// !rightBound = the operator is NOT tight-followed by an operand. Two encodings, because the trivia-sensitive
// `<s>` and the (trivia-insensitive, terminal-anchored) `>+>` each cover one half:
//   • `<s>` after — whitespace/newline follows (covers `a° + b`, `God()^`⏎). Trivia-sensitive.
//   • `>+>(…)` on the operator TERMINAL — a tight closing delimiter or EOF follows (covers `f(a°)`, `/x/...`,
//     `(/x)/`). `>+>` must anchor on the terminal (postfixOperatorToken/dotOperator); on a nonterminal or the
//     epsilon `""` it is a no-op. The delimiter set is swift-syntax's !rightBound char set minus whitespace/EOF.
// `@prefer` the whitespace-after (`<s>`) reading: `>+>` is trivia-INSENSITIVE (checks the next token
// past trailing trivia), so for `postfixOp <whitespace> <delimiter>` (e.g. `*!*`⏎`}`) BOTH the `<s>` alt
// and a `>+>` alt match the same span. They're same-span, so @prefer collapses the dual to the `<s>`
// reading; the `>+>` alts still uniquely cover the TIGHT delimiter / EOF cases where `<s>` can't match.
postfixExpression = @prefer postfixExpression >s< postfixOperator <s>
                  | postfixExpression >s< postfixOperatorToken >+> ( "." ")" "]" "}" "," ";" ":" )
                  | postfixExpression >s< dotOperator          >+> ( "." ")" "]" "}" "," ";" ":" ) .
postfixExpression = functionCallExpression .
postfixExpression = initializerExpression .
postfixExpression = explicitMemberExpression .
postfixExpression = subscriptExpression .
// No @prefer needed. The `x!!`/`x??` ambiguity (nested-force vs `!!` postfix-operator) is removed at
// the source: `postfixOperatorToken` can't begin with `!`/`?`, so there IS no `!!` operator reading
// (matching swift-syntax, which splits trailing `!`/`?` into individual force/optional tokens). This
// also avoids the keypath `?!`-component conflict a @prefer here would cause.
postfixExpression = forcedValueExpression .
postfixExpression = optionalChainingExpression .

// A postfix expression whose BASE cannot be a bare literal — for restricting trailing-closure-only calls (B1).
// Two cases:
//   (a) nonLiteralPrimary — the base itself is not a literal
//   (b) postfixExpression + any postfix operation — at least one operation was applied, so even a
//       literal-rooted chain (`1!`, `[1][0]`, `1.description`) is callable (matches swift-syntax)
nonLiteralPostfix = nonLiteralPrimary
                  | @prefer postfixExpression >s< postfixOperator <s>
                  | postfixExpression >s< postfixOperatorToken >+> ( "." ")" "]" "}" "," ";" ":" )
                  | postfixExpression >s< dotOperator          >+> ( "." ")" "]" "}" "," ";" ":" )
                  | functionCallExpression | initializerExpression | explicitMemberExpression
                  | subscriptExpression | forcedValueExpression | optionalChainingExpression .

// Grammar of a function call expression

functionCallExpression = postfixExpression >n< functionCallArgumentClause .   // >n<: a call `(` may not start a new line (swift-syntax `allowAtStartOfLine:false`) — `g()⏎(x)` is two statements, not `g()(x)`
// A trailing closure belongs to the SAME call as the argument clause: `f() { a }` = call `f` with args
// `()` AND trailing closure `{a}` (base = `f`), NOT `(f()) { a }` (base = `f()`). Both span `f(){a}`, so
// it's a same-span/different-alternate (flavor-3) choice → `@prefer` the args+closure reading. (The old
// `@longest` here pruned the shorter `f()` functionCallExpression globally, which ALSO killed the inner
// call of every chain `f()()`/`a[0](5)(4)` — @prefer is same-span so it can't touch those sub-derivations.)
functionCallExpression = @prefer postfixExpression functionCallArgumentClause trailingClosures    // f(args){closure} — preferred over base=`f()` (same span)
                       | nonLiteralPostfix trailingClosures .                                      // f{closure}: literal callees (bare `1{}`, `"s"{}`, `[1]{}`) are rejected (B1)

functionCallArgumentClause = "(" ")" | "(" functionCallArgumentList ","? ")" .
// `@prefer` the single-argument alternate: the two can only compete when ONE argument spans a
// top-level comma — i.e. a regex literal (`baz(/,/)` = one regex arg per swift-syntax probe;
// the operator-pair split `/` , `/` is the spurious reading). Ordinary lists (`f(a, b)`) have
// no single-arg parse over the whole span, so the preference never fires there. A spaced
// `baz(/, /)` can't lex as a regex (tight `>s<` closing) and stays two operator args.
// NO @prefer here. It was once added to prefer the single-arg reading of `baz(/,/)` (regex `/,/`
// as one arg) over the operator-pair split `/`,`/`. But `@prefer` is start-keyed and extent-blind
// (it's designed to prefer a LONGER same-start alternate, e.g. `foo<T>` over `foo`); used to prefer
// the SHORTER single-arg it pruned the legitimate multi-arg TAIL of every list whose start matched
// a single-arg start — which broke multi-arg subscripts `a[0, 1]` under the `?` OPT (the call path
// masked it; the OPT path didn't). The regex-vs-operator ambiguity it targeted is now resolved
// lexically (probe: `baz(/,/)`, `quxqux(/^/)` are unambiguous WITHOUT this @prefer), so it's obsolete.
functionCallArgumentList = functionCallArgument | functionCallArgument "," functionCallArgumentList .
// `@prefer expression`: an argument that lexes as BOTH a regex literal and one operator token
// (`quxqux(/^/)` — maximal-munch `/^/` is a single operatorToken) is the regex per swift-syntax
// (probe: RegexLiteralExpr). Bare operator args (`reduce(0, +)`) have no expression reading, so
// the preference never fires for them.
// `@longest`: a regex-vs-operator arg (`baz(/,/)`: regex `/,/` spans MORE than the operator `/`
// that would begin a 2-arg split) is an EXTENT choice — keep the longest arg, which drops the
// operator reading and kills the spurious split. `@prefer` (same-span) still resolves the emoji
// label case (`format: 📆` — identifier vs operator, same span). Ordinary args have one extent, so
// @longest is a no-op for them.
@longest
functionCallArgument = @prefer expression
                     | @prefer argumentLabel ":" expression .
functionCallArgument = operator
                     | argumentLabel ":" operator .
functionCallArgument = moduleSelector operator
                     | argumentLabel ":" moduleSelector operator .   // SE-0491: reduce(0, Swift::+)

// Call-site argument label: an identifier OR `_` (swift-syntax LabeledExpr.label allows .wildcard,
// e.g. `#Color(_: 1)`, and `_:` unlabeled additional trailing closures). `f(_)` (wildcard VALUE) is
// unaffected — that goes through `expression`; the `:` distinguishes label from value.
argumentLabel = softIdentifier | "_" .

// B2 — trailing closures partitioned by whether the closure is followed by `else`, so the Oracle can
// prune (via @excludedFrom) the followed-by-`else` reading inside a condition. Faithful to swift-syntax's
// atValidTrailingClosure (.stmtCondition): a trailing closure's `}` may not be followed by `else` (guard).
//   disc-3: not-followed-by-`else` — always a valid trailing closure.
trailingClosures = closureExpression >-> ( "else" ) labeledTrailingClosures? .
//   disc-3: followed-by-`else` — excluded inside a condition (dangling `{…}` → reject, matching swift).
trailingClosures = @excludedFrom(conditionExpression) closureExpression >+> ( "else" ) labeledTrailingClosures? .
//   disc-1: handled declaratively by the partitioned `closureExpression` + `@excludedFrom`
//   (see the `newlineOpenedClosure` alternate above) — no procedural filter.
labeledTrailingClosures = labeledTrailingClosure labeledTrailingClosures? .
labeledTrailingClosure = trailingClosureLabel ":" closureExpression .

// TODO: check the correctness of the statements below
// TODO: verify that exluding "_" and then adding "_" is neccessary
// `default` is the only keyword excluded from labeled trailing closure position — swift-syntax's
// atStartOfLabelledTrailingClosure() explicitly checks `self.at(.keyword(.default))` and returns
// false. All other keywords (including `case`, `return`, `for`, …) are valid trailing closure labels.
trailingClosureLabel = identifier ---( "_" "let" "var" "inout" "default" ) | "_" .


// Grammar of an initializer expression

//initializerExpression = postfixExpression "." init .
//initializerExpression = postfixExpression "." init "(" argumentNames ")" .

// `x.init` / `A.Module::init` / `x.init(a:b:)` need NO dedicated postfix rules: swift-syntax has
// no initializer-expression node — `super.init()` is FunctionCall(MemberAccess(…, init)) — and
// explicitMemberExpression's softIdentifier already matches `init` (the dedicated forms only
// duplicated it, creating the [explicitMemberExpression]|[initializerExpression] dual).
// Bare `init` reference (implicit self.init), e.g. `init(x: 1)` inside an initializer body.
// swift-syntax parseDeclReferenceBase (Names.swift:204) accepts `.keyword(.init)` as a base name,
// so `init` is a decl-reference expression; the `(x: 1)` call / `!` build on it via the normal
// postfix machinery. `init` is excluded from `identifier`, hence this dedicated alternate.
initializerExpression = "init" .

// Grammar of an explicit member expression

// swift-syntax parseDottedExpressionSuffix (Expressions.swift:699) calls
// parseDeclReferenceExpr with `.keywords` flag (Names.swift:218-220), which accepts
// any lexer-classified keyword as the member name (`x.default`, `x.deinit`,
// `x.subscript`, `x.where`, `x.case`, …). softIdentifier (identifier minus
// `let`/`var`/`inout`) covers all of these in one rule. The dedicated rules for
// `x.init` (initializerExpression) and `x.self` (postfixSelfExpression) below
// still match — GLL keeps the extra parses but they're harmless. TODO: WTF???

explicitMemberExpression = postfixExpression "." decimalDigits .
explicitMemberExpression = postfixExpression "." moduleSelector? softIdentifier .
explicitMemberExpression = @prefer postfixExpression "." moduleSelector? softIdentifier genericArgumentClause .
explicitMemberExpression = postfixExpression "." moduleSelector? softIdentifier "(" argumentNames ")" .
explicitMemberExpression = postfixExpression conditionalCompilationBlock .

argumentNames = argumentName argumentNames? .
argumentName = softIdentifier ":" .

// Grammar of a subscript expression

// postfixSelfExpression removed — swift-syntax parses `Foo.self` as a MemberAccessExpr
// (Expressions.swift:689 consumes `self`/tuple-index as the declName baseName), i.e. via
// explicitMemberExpression (softIdentifier matches `self`). The separate production was
// redundant and produced the `[explicitMemberExpression]|[postfixSelfExpression]` ambiguity.

// Split empty vs non-empty (NOT `functionCallArgumentList?`): the `?` OPT wrapping the
// `@prefer functionCallArgument` list breaks multi-arg subscripts (`a[0, 1]`, `data[position,
// default: 0]`), while an empty subscript `a[]` IS valid — so both alternates are needed. Mirrors
// functionCallArgumentClause's `"(" ")" | "(" list ")"`. >n<: a subscript `[` may not start a new line.
// Split empty vs non-empty (NOT `functionCallArgumentList?`): in the FULL grammar the `?` OPT
// form fails multi-arg subscripts (`a[0, 1]`, `data[position, default: 0]`) — a deep interaction
// with the full expression grammar (NOT a general @prefer/OPT flaw: minimal @prefer-under-OPT,
// even left-recursive, is proven sound in CoreGrammarTests/OracleDisambiguation). Empty `a[]` is
// valid, so both alternates are needed. Mirrors functionCallArgumentClause's `"(" ")" | "(" list ")"`.
subscriptExpression = postfixExpression >n< "[" functionCallArgumentList? "]" .   // clean OPT (empty `a[]` + multi `a[0,1]`); works now that the obsolete @prefer on functionCallArgumentList is gone. >n<: a subscript `[` may not start a new line.

// Grammar of a forced-value expression

forcedValueExpression = postfixExpression >s< forceMark .

// Grammar of an optional-chaining expression

optionalChainingExpression = postfixExpression >s< optionalMark .



// STATEMENTS
 
// Grammar of a statement

statement = >->(declaration) expression .   // an expression-statement only where a declaration does NOT start here (swift-syntax atStartOfDeclaration-first). Resolves the `open⏎var` modifier-vs-reference ambiguity: `open` before a decl is the declaration's modifier, not a bare reference. See `Grammar Predicate Lookahead Design.md`.
// `@prefer`: where a declaration and an expression parse the SAME span (`init() {}` = decl vs
// `init`-ref + call + trailing closure), swift-syntax commits to the declaration (probe:
// InitializerDecl in a func body; its parseCodeBlockItem tries atStartOfDeclaration first).
// The two carve-outs where the EXPRESSION must win are structural, not preference-based:
// bare `#foo` (macroExpansionDeclaration requires attributes/modifiers at statement level) and
// bodyless `init()` (initializerDeclaration requires a body at statement level).
statement = @prefer declaration .
statement = loopStatement .
// `if`/`switch` arrive via `statement = expression` (first `expression` alternative covers
// `conditionalExpression`); branchStatement holds only `guard` (the sole keyword-led true statement).
statement = branchStatement .
statement = labeledStatement .
statement = controlTransferStatement .
statement = deferStatement .
statement = doStatement .
statement = compilerControlStatement .
statement = yieldStatement .
statement = discardStatement .

// swift-syntax parseYieldStatement (Statements.swift:737-783): `yield expr` or `yield ( expr, expr, ... )` with optional trailing comma; empty `yield()` also allowed.
// 'yield' is not formally part of Swift yet, but it's the body shape for _read/_modify/read/modify/borrow/mutate coroutine accessors.
// `<s> >n<`: the yielded expression must be on the SAME line (swift-syntax atContextualKeyword,
// Statements.swift). `yield⏎expr` does NOT yield — `yield` is then a plain identifier and `expr`
// a separate statement (probe: YieldStmt=false). Mirrors discardStatement's contextual-keyword gate.
// `>->("(" "[" ".")`: negative forward lookahead reproducing swift-syntax's `preferPostfixExpr: true`
// gate (atStartOfStatement → atContextualKeywordPrefixedSyntax, Statements.swift:1052 for both
// `yield` and `discard`). When `yield` is followed by a postfix suffix `(`/`[`/`.`, swift-syntax reads
// it as a CALL/subscript/member on the identifier `yield`, NOT a yield statement (spacing irrelevant:
// `yield(x)` and `yield (x)` are both calls; `yield ()`/`yield[0]`/`yield.f` likewise). The gate kills
// the yieldStatement reading exactly there, leaving the expression-statement (call) reading unopposed.
// Non-suffix operands (`yield foo`, `yield 5`, `yield &x`) have no call reading, so they stay yields.
// A pure CFG can't express this 1-token peek; this is swift-syntax's own mechanism, in grammar form.
yieldStatement = "yield" >-> ( "(" "[" "." ) <s> >n< expression .

// SE-0390 (discard) statement: swift-syntax parseDiscardStatement (Statements.swift:373-382).
// Contextual keyword like consume/borrow/copy — same `<s> >n<` whitespace boundary AND the same
// `preferPostfixExpr: true` gate as yield (Statements.swift:1052-1056). `discard self` → keyword form;
// `discard(self)`/`discard (self)` → call on the `discard` identifier — hence the same `>->` suffix gate.

discardStatement = "discard" >-> ( "(" "[" "." ) <s> >n< expression .

//statements = statement statements? .
statements = statement ";"? .
statements = statement statementSeparator statements .
statementSeparator = <n> | ";" .
//statements = statement { (<n> | ";") statement } [";"] . // ebnf

// Grammar of a loop statement

loopStatement = forInStatement .
loopStatement = whileStatement .
loopStatement = repeatWhileStatement .

// Grammar of a for-in statement

//forInStatement = "for" "case" matchPattern "in" expression whereClause? codeBlock .
//forInStatement = "for" bindingPattern "in" expression whereClause? codeBlock .
// swift-syntax parseForStatement (Statements.swift:554-589):
// `for try? await? unsafe? case? pattern type-annotation? in expression where? body`.
// `unsafe` is consumed as a modifier only when the next token isn't `in` or `:`
// (Statements.swift:563) — so `for try await unsafe in e {}` parses with `unsafe`
// as the loop pattern. GLL explores both interpretations via the optional `unsafe?`.
forInStatement = "for" "try"? "await"? "unsafe"? "case" matchPattern "in" expression whereClause? codeBlock .
forInStatement = "for" "try"? "await"? "unsafe"? bindingPattern "in" expression whereClause? codeBlock .

// Grammar of a while statement

whileStatement = "while" >-> ( "{" ) conditionList codeBlock .   // B2 discriminator 2: `while { true } {}` is a reject

conditionList = condition | condition "," conditionList .
condition = conditionExpression
          | availabilityCondition
          | caseCondition
          | optionalBindingCondition .
// `#available`/`#unavailable` are excluded from macroHead, so no spurious macro-call reading competes here — no @prefer needed

caseCondition = "case" matchPattern initializer .
optionalBindingCondition = "let" bindingPattern initializer? | "var" bindingPattern initializer? .

// Grammar of a repeat-while statement

repeatWhileStatement = "repeat" codeBlock "while" >-> ( "{" ) conditionExpression .   // B2 discriminator 2: `repeat {} while { true }()` is a reject (testRecovery28)

// Grammar of a branch statement

// `if`/`switch` moved to conditionalExpression (they are IfExpr/SwitchExpr in swift-syntax);
// only `guard` remains a branch statement (GuardStmt).
branchStatement = guardStatement .

// Grammar of a guard statement

guardStatement = "guard" >-> ( "{" ) conditionList "else" codeBlock .   // B2 discriminator 2: a guard condition may not open with `{`

switchCases = switchCase switchCases? .
switchCase = caseLabel statements .
switchCase = defaultLabel statements .
switchCase = conditionalSwitchCase .

caseLabel = attributes? "case" caseItemList ":" .
caseItemList = matchPattern whereClause? | matchPattern whereClause? "," caseItemList .
defaultLabel = attributes? "default" ":" .

whereClause = "where" whereExpression .
whereExpression = conditionExpression .

conditionalSwitchCase = switchIfDirectiveClause switchElseifDirectiveClauses? switchElseDirectiveClause? endifDirective .
switchIfDirectiveClause = ifDirective compilationCondition switchCases? .
switchElseifDirectiveClauses = switchElseifDirectiveClause switchElseifDirectiveClauses? .
switchElseifDirectiveClause = elseifDirective compilationCondition switchCases? .
switchElseDirectiveClause = elseDirective switchCases? .

// Grammar of a labeled statement

labeledStatement = statementLabel loopStatement .
// labeled `if`/`switch` are LabeledStmt wrapping the if/switch EXPRESSION (swift-syntax).
labeledStatement = statementLabel conditionalExpression .
labeledStatement = statementLabel doStatement .

statementLabel = labelName ":" .
labelName = hardIdentifier .

// Grammar of a control transfer statement

controlTransferStatement = breakStatement .
controlTransferStatement = continueStatement .
controlTransferStatement = fallthroughStatement .
controlTransferStatement = returnStatement .
controlTransferStatement = throwStatement .

// Grammar of a break statement

breakStatement = "break" labelName? .

// Grammar of a continue statement

continueStatement = "continue" labelName? .

// Grammar of a fallthrough statement

fallthroughStatement = "fallthrough" .

// Grammar of a return statement

returnStatement = "return" expression? .

// Grammar of a throw statement

throwStatement = "throw" expression .

// Grammar of a defer statement

deferStatement = "defer" codeBlock .

// Grammar of a do statement

doStatement = "do" throwsClause? codeBlock catchClauses? .
catchClauses = catchClause catchClauses? .
catchClause = "catch" catchPatternList? codeBlock .
catchPatternList = catchPattern | catchPattern "," catchPatternList .
catchPattern = matchPattern whereClause? .
// swift-syntax parseGuardedCatchPattern (Statements.swift:472-473): `catch {` or
// `catch where ...` produces an implicit `let error` pattern, so the explicit
// pattern is optional when a where-clause is present.
catchPattern = whereClause .

// Grammar of a compiler control statement

compilerControlStatement = conditionalCompilationBlock .
compilerControlStatement = lineControlStatement .
// diagnosticStatement removed: `#warning(…)`/`#error(…)` are MacroExpansionExpr in swift-syntax
// (probe-verified) — reached via expression → macroExpansionExpression, no dedicated rule needed.

// Grammar of a conditional compilation block

conditionalCompilationBlock = ifDirectiveClause elseifDirectiveClauses? elseDirectiveClause? endifDirective .

// no code on the same line after #if, #elseif, #else, #endif
ifDirectiveClause = ifDirective compilationCondition <n> statements? .
elseifDirectiveClauses = elseifDirectiveClause elseifDirectiveClauses? .
elseifDirectiveClause = elseifDirective compilationCondition <n> statements? .
elseDirectiveClause = elseDirective statements? .
ifDirective = "#if" .
elseifDirective = "#elseif" .
elseDirective = "#else" <n> .
endifDirective = "#endif" <n> .

compilationCondition = hardIdentifier .
compilationCondition = booleanLiteral .
compilationCondition = "(" compilationCondition ")" .
compilationCondition = "!" >s< compilationCondition .
compilationCondition = compilationCondition "&&" compilationCondition .
compilationCondition = compilationCondition "||" compilationCondition .
// swift-syntax parses the whole `#if` condition as a general expression (Directives.swift:67), so
// every `name(args)` is a function-call expression: os(macOS), arch(arm64), canImport(Foo),
// targetEnvironment(simulator), hasAttribute(x), AND unknown ones like hasGreeble(blah). The
// platform-condition argument shapes are NOT validated syntactically (compiler diagnoses misuse).
// Version comparisons need no special rules either: `swift(>=5)` / `compiler(>=10.0)` /
// `canImport(A, _version: >=2.2)` parse via this generic call with `>=5` as a tight-prefix
// operator expression — exactly swift-syntax's reading. (The former versionComparison specials
// duplicated it once prefix operators became rightBound → the [identifier-call]|[platformCondition] dual.)
compilationCondition = hardIdentifier functionCallArgumentClause .   // reuse the general call-argument clause (handles multi-arg + labels + trailing comma); the inline "(" functionCallArgumentList? ","? ")" form failed on multi-arg conditions like canImport(A, _version: 2)

// Grammar of a line control statement

lineControlStatement = "#sourceLocation" "(" "file" ":" filePath "," "line" ":" lineNumber ")" .
lineControlStatement = "#sourceLocation" "(" ")" .

//lineNumber = A decimal integer greater than zero .
lineNumber = /0*[1-9][0-9]*/ .

filePath = staticStringLiteral .

// Grammar of an availability condition

availabilityCondition = "#available" "(" availabilityArguments ")" .
availabilityCondition = "#unavailable" "(" availabilityArguments ")" .
availabilityArguments = availabilityArgument | availabilityArgument "," availabilityArguments .
availabilityArgument = platformName platformVersion? .   // version optional: `#available(OSX)`, `#available(…, unavailable)` are bare identifiers (swift-syntax parses them syntactically, diagnoses the missing version later). Previously only accepted via the #available-macro reading, now removed.
availabilityArgument = "*" .

// swift-syntax parsePlatformVersion (Availability.swift:202) accepts any identifier
// as the platform name (incl. legacy `OSX`, custom build aliases). Compiler validates later.
platformName = hardIdentifier .
platformVersion = decimalDigits .
platformVersion = decimalDigits "." decimalDigits .
platformVersion = decimalDigits "." decimalDigits "." decimalDigits .



// DECLARATIONS

// Grammar of a declaration

declaration = importDeclaration .
declaration = constantDeclaration .
declaration = variableDeclaration .
declaration = typealiasDeclaration .
declaration = functionDeclaration .
declaration = enumDeclaration .
declaration = structDeclaration .
declaration = classDeclaration .
declaration = actorDeclaration .
declaration = protocolDeclaration .
declaration = initializerDeclaration .
declaration = deinitializerDeclaration .
declaration = extensionDeclaration .
declaration = subscriptDeclaration .
declaration = macroDeclaration .
declaration = operatorDeclaration .
declaration = precedenceGroupDeclaration .
declaration = associatedTypeDeclaration .  // TODO: verify grammar fix.
// Freestanding macro expansion `#foo`, probe-verified against swift-syntax:
//   - BARE `#foo` at statement/top-level/func-body/expression position → MacroExpansionExpr
//     (an expression), NOT a declaration.
//   - BARE `#foo` in MEMBER position (struct/class/protocol/enum/extension body) → MacroExpansionDecl.
//   - ATTRIBUTED/MODIFIED `@attr #foo` / `public #foo` → MacroExpansionDecl everywhere (an
//     expression can't carry attributes/modifiers, so there is no expression competitor).
// So the attributed/modified form (macroExpansionDeclaration, requires a leading attr or modifier)
// stays in the statement-shared `declaration`; the BARE form (freestandingMacroExpansionDeclaration)
// is added only in `memberDeclaration`. This removes the bare-`#foo` `[declaration] | [expression]`
// ambiguity at statement level while keeping `@attr #foo` (a decl) and member `#foo` (a decl) intact.
memberDeclaration = declaration | freestandingMacroExpansionDeclaration | bodylessInitializerDeclaration .
// swift-syntax parseDecl recognizes `case` as the start of an EnumCaseDeclSyntax in any member
// context; the compiler enforces the semantic constraint that cases only live in enum bodies.
// NB: not in TSPL (which reaches the case clause only via enum members). We keep it so
// `case` parses in any member block — matching swift-syntax's *parser*, which accepts
// `case` in struct/class/extension (testEnum12/13/14 use plain assertParse); the compiler
// rejects those only semantically. `enumMember` therefore uses just `declaration` (not a
// second `enumCaseDeclaration` alternate), so `case` has exactly one parse — no ambiguity.
declaration = @confinedTo(memberDeclaration) enumCaseDeclaration .   // `case`-as-declaration is valid ONLY inside a type-member block (struct/class/enum/actor/protocol/extension all reach it via `memberDeclaration`); at top level or in a function body `case` is not a declaration (swift-syntax rejects — testEnum11). Containment predicate, see `Grammar Predicate Lookahead Design.md`.
declaration = macroExpansionDeclaration .   // attributed/modified freestanding macro (see below); bare form is member-only

// macroExpansionDeclaration REQUIRES a leading attribute or declaration-modifier (so a bare `#foo`
// is not a decl at statement level — it's an expression). Two alternates: attributes (modifiers
// optional), or modifiers alone. Reachable via `declaration` (statement + member).
macroExpansionDeclaration = attributes declarationModifiers? macroHead genericArgumentClause? functionCallArgumentClause? trailingClosures? .
macroExpansionDeclaration = declarationModifiers macroHead genericArgumentClause? functionCallArgumentClause? trailingClosures? .
// Bare freestanding macro expansion (no attributes/modifiers) — a declaration only in MEMBER
// position (added via memberDeclaration); at statement level the bare form is an expression.
freestandingMacroExpansionDeclaration = macroHead genericArgumentClause? functionCallArgumentClause? trailingClosures? .
// A macro head is a SINGLE token `#name` (regex — `#` and the name are one lexeme). This is what
// lets `---` exclude the RESERVED pound-keywords: the excluded literal (`#available`) co-matches the
// exact same span as `poundName`, so the exclusion (same-position/same-end suppression) fires. With
// the old `"#" + identifier` the name token started AFTER the `#`, so no reserved literal shared
// its position and `---` was a silent no-op. Reserved keywords have dedicated rules (availability /
// #if directives / #sourceLocation); everything else (`#foo`, `#selector`, `#colorLiteral`, …) is a macro.
poundName - @builder .   // `#` + identifier (N1518 ranges); `_` included in identifierHead. Bare `#_` excluded at macroHead below.
macroHead = poundName ---( "#_" "#available" "#unavailable" "#if" "#elseif" "#else" "#endif" "#sourceLocation" ) .
macroHead = "#" >s< moduleSelector identifier ---( "_" ) .   // SE-0491 #Module::macro (rare; keeps the module-qualified form)

//  "#error" "#warning" "#fileLiteral" "#colorLiteral" "#imageLiteral" "#keyPath" "#selector"


// Grammar of a code block

codeBlock = "{" statements? "}" .

// Grammar of an import declaration

importDeclaration = attributes? "import" importKind? importPath .
importDeclaration = attributes? "import" importKind moduleSelector ( hardIdentifier | operatorName ) .   // SE-0491 module-selected symbol import: `import struct Mod::A`, `import func Mod::+`. Requires a kind AND single symbols either side of `::`. The imported declName is swift-syntax `parseAnyIdentifier` = an identifier OR an operator (`import func Mod::+`/`::<`), NOT a keyword (`import struct Mod::class` rejects) — probe-verified. No-kind `import Mod::A`, dotted `Mod.Sub::A`/`Mod::A.B`, double `::` all reject.

importKind = "typealias" | "struct" | "class" | "enum" | "protocol" | "let" | "var" | "func" .
importPath = hardIdentifier | hardIdentifier "." importPath .   // NO moduleSelector: SE-0491 `::` disambiguates reference expressions, NOT import paths — swift-syntax rejects `import a::b` / `import struct M.S::A` (probe-verified hasError). Import paths are plain dotted identifiers.

// No dedicated `"async"?` slot: `async` is already a declarationModifier (as in swift-syntax,
// where `async let` puts `async` in VariableDecl.modifiers), so a separate slot only duplicated
// that reading. (TSPL lacks async-let entirely — https://github.com/swiftlang/swift-book/issues/425.)

// Grammar of a constant declaration

constantDeclaration = attributes? declarationModifiers? "let" patternInitializerList .

patternInitializerList = patternInitializer | patternInitializer "," patternInitializerList .
patternInitializer = bindingPattern initializer? .
initializer = assignmentOperator expression .

// Grammar of a variable declaration

variableDeclaration = variableDeclarationHead patternInitializerList .
// `… typeAnnotation codeBlock` removed: subsumed by `… getterSetterBlock` (getterSetterBlock
// has a `codeBlock` alternate for the implicit-getter body), which eliminated a redundant parse.
variableDeclaration = variableDeclarationHead variableName typeAnnotation getterSetterBlock .
variableDeclaration = variableDeclarationHead variableName initializer willSetDidSetBlock .
variableDeclaration = variableDeclarationHead variableName typeAnnotation initializer? willSetDidSetBlock .
variableDeclaration = variableDeclarationHead variableName typeAnnotation initializer getterSetterBlock .   // TODO: SE-0400 init accessors with default value (swift-syntax: PatternBindingSyntax accepts initializer + accessorBlock, Declarations.swift:1622-1644)

variableDeclarationHead = attributes? declarationModifiers? "var" .
variableName = hardIdentifier | "_" .   // `_` = wildcard-named computed property, e.g. `static var _: Int { 0 }` (swift-syntax accepts; stored `var _ = 0` goes via bindingPattern)

getterSetterBlock = codeBlock .
//getterSetterBlock = "{" getterClause setterClause? "}" .
//getterSetterBlock = "{" setterClause getterClause "}" .
//getterClause = attributes? mutationModifier? "get" codeBlock .
// `@prefer` the accessor reading: `{ get {} set {} }` parses both as accessors AND as a codeBlock
// (get/set as identifiers with trailing closures); swift-syntax commits to accessors when accessor
// keywords are present. A plain getter body (`{ return 1 }`) has no accessor parse, so codeBlock stands.
getterSetterBlock = @prefer "{" accessorClauseList "}" .   // swift-syntax AccessorBlock = "{" AccessorDeclList "}"; the accessor-vs-codeBlock commitment is atStartOfGetSetAccessor (Lookahead.swift:252)
// swift-syntax parseAccessorDecl (Declarations.swift:1736) calls parseAccessorEffectSpecifiers
// for EVERY accessor keyword (get/set/init/willSet/didSet/_read/_modify/...). Effects aren't
// getter-specific; the `accessorEffects` non-terminal below is shared across all clauses.
// `codeBlock?` optional: swift-syntax's AccessorDecl body is optional, so a bare `get`/`set`
// (protocol requirement `{ get }`, `{ get set }`) is just an accessor with no body — no separate
// getterSetterKeywordBlock needed. `@prefer accessorClauseList` (above) makes `{ get }` bind as
// an accessor rather than a codeBlock with `get` as an identifier-expression.
getterClause = attributes? accessorModifier? "get" accessorEffects? codeBlock? .
setterClause = attributes? accessorModifier? "set" setterName? accessorEffects? codeBlock? .
setterName = "(" hardIdentifier ")" .

accessorClauseList = accessorClauseEntry accessorClauseList? .
accessorClauseEntry = getterClause | setterClause | initAccessorClause | coroutineAccessorClause .
initAccessorClause = attributes? "init" setterName? accessorEffects? codeBlock .
coroutineAccessorClause = attributes? accessorModifier? coroutineSpecifier accessorEffects? codeBlock .
coroutineSpecifier = "_read" | "read" | "_modify" | "modify" | "borrow" | "mutate" .

// TODO: Accessor-level modifier — surgical, matches swift-syntax AccessorModifier enum (TokenSpecSet.swift:63-89).
// Distinct from `mutationModifier` which is used in declaration-modifier list.
accessorModifier = "mutating" | "nonmutating" | "borrowing" | "consuming" | "__consuming" .

// getterSetterKeywordBlock / getterKeywordClause / setterKeywordClause removed: a bodyless
// `{ get }` / `{ get set }` / `{ set get }` is now an accessorClauseList of bodyless get/set
// clauses (see `codeBlock?` above), matching swift-syntax's single AccessorBlock model.

willSetDidSetBlock = "{" willSetClause didSetClause? "}" .
willSetDidSetBlock = "{" didSetClause willSetClause? "}" .
willSetClause = attributes? "willSet" setterName? accessorEffects? codeBlock .
didSetClause = attributes? "didSet" setterName? accessorEffects? codeBlock .

// Shared `parseAccessorEffectSpecifiers` shape (Specifiers.swift): `throws` alone, or `async` optionally
// followed by `throws`. Typed throws (`throws(E)`) parsing in accessor positions is handled by `throwsClause`
// elsewhere — kept simple here per current grammar style.
accessorEffects = "throws" .
accessorEffects = "async" "throws"? .

// Grammar of a type alias declaration

typealiasDeclaration = attributes? accessLevelModifier? "typealias" typealiasName genericParameterClause? typealiasAssignment .
typealiasName = hardIdentifier .
typealiasAssignment = assignmentOperator type .

// Grammar of a function declaration

// `functionBody?` is optional — swift-syntax parses funcs with `parseOptionalCodeBlock`, so a
// bodiless `func f()` is syntactically valid EVERYWHERE (top-level too; a missing body is a
// semantic, not syntactic, error — e.g. `@objc func f(_: Int)`, `@abi(func fn()) func fn()`).
// `@longest` reproduces swift's greedy body capture: when a `{` follows the signature it IS the
// body, so the longest functionDeclaration (body taken) wins over the bodiless reading. That
// prunes the testClosureLiterals#3 fork (bodiless func + a separate `{…}(…)` IIFE statement)
// post-parse on the BSR — the same safe maximal-munch as `@longest numericLiteral` — WITHOUT
// rejecting genuine bodiless funcs.
@longest
functionDeclaration = functionHead functionName genericParameterClause? functionSignature genericWhereClause? functionBody? .

functionHead = attributes? declarationModifiers? "func" .
// swift-syntax parseFuncDeclaration (Declarations.swift:1384) uses expectIdentifier(keywordRecovery: true)
// so a hard keyword can be consumed as the function name without `hasError` — e.g. `func await()`,
// `func async()`. softIdentifier (raw identifier minus let/var/inout) matches that behavior.
functionName = hardIdentifier | operatorName .   // hardIdentifier (reserved-excluded), NOT softIdentifier: a reserved keyword is not a valid function name (`func repeat()` errors — testInvalid17/21), while contextual keywords (`func async()`, `func await()`, `func open()`) and backticked keywords still parse. `init`/`deinit` stay excluded (both reject as function names — probe-verified).

functionSignature = parameterClause "async"? throwsClause? functionResult? .
functionSignature = parameterClause "async"? "rethrows" functionResult? .
functionResult = "->" type .   // result-type attributes carried by `type`
functionBody = codeBlock .

parameterClause = "(" ")" | "(" parameterList ","? ")" .
parameterList = parameter | parameter "," parameterList .

// TODO:  verify missing attributes? grammar error   https://github.com/swiftlang/swift-book/issues/294
// `@shortest [ parameterDeclarationModifiers ]`: a modifier word followed by ONE name is the external
// name, NOT a modifier — swift-syntax parses `f(_const map: T)` as external `_const` + local `map`
// (probe: empty DeclModifierList), and only `f(_const x y: T)` (two names) makes `_const` a
// modifier. @avoid prefers the skip; where skipping can't parse (three words), the modifier is taken.
// `parameterNames` groups the one-or-two names (mirrors swift-syntax parseParameterNames) so the
// slot after the @avoid bracket has a COMMON END — pruneByPivot groups on (i,j) and needs the
// mandatory follower to end at the same j in both readings.
parameter = attributes? @shortest [ parameterDeclarationModifiers ] parameterNames typeAnnotation defaultArgumentClause? .
parameter = attributes? @shortest [ parameterDeclarationModifiers ] parameterNames typeAnnotation "..." .

parameterNames = externalParameterName localParameterName | localParameterName .
externalParameterName = softIdentifier | "_" .  // accept all keywords except let, var, inout; `_` = wildcard name (swift-syntax firstName/secondName allow .wildcard)
localParameterName = softIdentifier | "_" .     // but references to the parameter in the function body must use backticks


parameterModifiers = parameterModifier parameterModifiers? .   // TODO: swift-syntax Types.swift:1256-1280 repeat loop — multiple type-specifiers can stack
parameterModifier = "inout" | "borrowing" | "consuming" | "isolated" | "_const" | "sending" | "__shared" | "__owned" .   // TODO: swift-syntax SimpleTypeSpecifierSyntax.SpecifierOptions (Parser+TokenSpecSet.swift:3570)
parameterModifier = "nonisolated" >s< "(" "nonsending" ")" .  // TYPE specifier form ONLY — swift-syntax rejects a bare `nonisolated` type specifier (`nonisolated Int`, `nonisolated () -> Void` all hasError). Bare `nonisolated` is a DECL modifier (actorIsolationModifier), not a type specifier. Dropping the bare alternate also removes the `let x: nonisolated⏎(hello)` residual ambiguity (reading B was bare-nonisolated + `(hello)` as a parenthesized type). swift-syntax parseNonisolatedTypeSpecifier (Types.swift:1179)
parameterModifier = "dependsOn" >s< "(" "scoped"? identifierList ")" .        // TODO: swift-syntax parseLifetimeTypeSpecifier (Types.swift:1121): SE-0432 lifetime dependencies
parameterDeclarationModifiers = parameterDeclarationModifier parameterDeclarationModifiers? .   // TODO: swift-syntax stacks them in a while-loop
parameterDeclarationModifier = "_const" | "isolated" .    // TODO: verify parameter-declaration modifiers (swift-syntax ParameterModifier, TokenSpecSet.swift:814)
defaultArgumentClause = assignmentOperator expression .

// Grammar of an enumeration declaration

// ONE enum declaration — swift-syntax has a single EnumDeclSyntax; the raw-value-style
// vs union-style distinction is SEMANTIC (compiler-enforced), not syntactic. The old
// two-alternate form (`unionStyleEnum` | `rawValueStyleEnum`) was redundant — rawValueStyle
// was a strict subset (it only required the typeInheritanceClause that unionStyle made
// optional) — producing the `enumDeclaration [rawValueStyleEnum]|[unionStyleEnum]` ambiguity.
enumDeclaration = attributes? accessLevelModifier? "indirect"? "enum" enumName genericParameterClause? typeInheritanceClause? genericWhereClause? "{" enumMembers? "}" .
enumMembers = enumMember ";"? .
enumMembers = enumMember statementSeparator enumMembers .
// `declaration` already reaches `enumCaseDeclaration` (see `declaration = enumCaseDeclaration`),
// so we do NOT list it again here — listing both is what caused the
// `[declaration]|[enumCaseDeclaration]` double-parse. One alternate ⇒ one parse for `case`.
enumMember = memberDeclaration | compilerControlStatement .

// swift-syntax `parseEnumCaseParameter` (Parameters.swift:241-295): associated values are a
// distinct EnumCaseParameterListSyntax with function-parameter-like elements — optional
// firstName/secondName labels (when followed by `:`), required type, optional default value.
// NOT tuple-type elements (which only allow a single label per element).
associatedValues = "(" enumCaseParameterList ")" .
enumCaseParameterList = enumCaseParameter | enumCaseParameter "," enumCaseParameterList .
enumCaseParameter = type defaultArgumentClause? .   // specifiers carried by `type`
enumCaseParameter = parameterModifiers? externalArgumentLabel? localArgumentLabel typeAnnotation defaultArgumentClause? .

enumName = hardIdentifier .
enumCaseName = hardIdentifier .

// (rawValueStyleEnum / union-style split removed — merged into the single enumDeclaration above.)

// Unified enum-case declaration matching swift-syntax EnumCaseDeclSyntax:
// each element has optional associated-values (parameter clause) AND optional `= expression`
// raw-value initializer. swift-syntax doesn't split union-style from raw-value-style; the
// compiler enforces the "one form per enum" rule semantically.
enumCaseDeclaration = attributes? "indirect"? "case" enumCaseElementList .
enumCaseElementList = enumCaseElement | enumCaseElement "," enumCaseElementList .
enumCaseElement = enumCaseName associatedValues? enumCaseRawValueInitializer? .
enumCaseRawValueInitializer = assignmentOperator expression .

// Grammar of a structure declaration

structDeclaration = attributes? accessLevelModifier? "struct" structName genericParameterClause? typeInheritanceClause? genericWhereClause? structBody .
structName = hardIdentifier .
structBody = "{" structMembers? "}" .

structMembers = structMember ";"? .
structMembers = structMember statementSeparator structMembers .
structMember = memberDeclaration | compilerControlStatement .
// TODO: Swift 6.3 grammar bug see issue https://github.com/swiftlang/swift-book/issues/201

// Grammar of a class declaration

classDeclaration = attributes? accessLevelModifier? "final"? "class" className genericParameterClause? typeInheritanceClause? genericWhereClause? classBody .
classDeclaration = attributes? "final" accessLevelModifier? "class" className genericParameterClause? typeInheritanceClause? genericWhereClause? classBody .
className = hardIdentifier .
classBody = "{" classMembers? "}" .

classMembers = classMember ";"? .
classMembers = classMember statementSeparator classMembers .
classMember = memberDeclaration | compilerControlStatement .
// TODO: Swift 6.3 grammar bug see issue https://github.com/swiftlang/swift-book/issues/201

// Grammar of an actor declaration

actorDeclaration = attributes? accessLevelModifier? "actor" actorName genericParameterClause? typeInheritanceClause? genericWhereClause? actorBody .
actorName = hardIdentifier .
actorBody = "{" actorMembers? "}" .

actorMembers = actorMember ";"? .
actorMembers = actorMember statementSeparator actorMembers .
actorMember = memberDeclaration | compilerControlStatement .
// TODO: Swift 6.3 grammar bug see issue https://github.com/swiftlang/swift-book/issues/201

// Grammar of a protocol declaration

protocolDeclaration = attributes? accessLevelModifier? "protocol" protocolName primaryAssociatedTypeClause? typeInheritanceClause? genericWhereClause? protocolBody .  // TODO: SE-0346 primary associated types
protocolName = hardIdentifier .

primaryAssociatedTypeClause = openAngle primaryAssociatedTypeList ","? closeAngle .
primaryAssociatedTypeList = hardIdentifier | hardIdentifier "," primaryAssociatedTypeList .
protocolBody = "{" protocolMembers? "}" .

protocolMembers = protocolMember ";"? .
protocolMembers = protocolMember statementSeparator protocolMembers .
// swift-syntax parses protocol bodies with the SAME member parser as class/struct (members are
// FunctionDeclSyntax, InitializerDeclSyntax, VariableDeclSyntax, …, not protocol-specific nodes).
// So a protocol member is just a general `declaration`. This is a REPLACEMENT of the former
// protocol-specific rules (not an addition), so it introduces no ambiguity, and it accepts the
// forms swift-syntax accepts syntactically (init/deinit with bodies, computed properties, etc.)
// that the compiler then rejects semantically. The bodyless `var x: Int { get set }` /
// `subscript(...) { get }` forms are already covered by variableDeclaration / subscriptDeclaration.
protocolMember = memberDeclaration | compilerControlStatement .
// TODO: Swift 6.3 grammar bug see issue https://github.com/swiftlang/swift-book/issues/201

// protocolAssociatedTypeDeclaration = attributes? accessLevelModifier? "associatedtype" typealiasName typeInheritanceClause? typealiasAssignment? genericWhereClause? .
associatedTypeDeclaration = attributes? declarationModifiers? "associatedtype" typealiasName typeInheritanceClause? typealiasAssignment? genericWhereClause? .  // TODO: verify grammar fix

// Grammar of an initializer declaration

// swift-syntax parseInitializerDeclaration (Declarations.swift:1269) uses
// parseOptionalCodeBlock — body is syntactically optional, compiler enforces it.
// swift-syntax parseInitializerDeclaration uses parseFunctionSignature, which includes an optional
// return clause — so `init() -> Type` is syntactically accepted (compiler rejects it semantically).
// Body REQUIRED here: at statement position a bodyless `init()` is a CALL expression, not a decl
// (probe: swift-syntax parses `init()` in a `#if` inside an init body as FunctionCallExpr, but
// `init() {}` in a func body as InitializerDecl). The bodyless decl form (protocol requirement
// `init()`) is member-only — see bodylessInitializerDeclaration in memberDeclaration.
initializerDeclaration = initializerHead genericParameterClause? parameterClause "async"? throwsClause? functionResult? genericWhereClause? initializerBody .
initializerDeclaration = initializerHead genericParameterClause? parameterClause "async"? "rethrows" functionResult? genericWhereClause? initializerBody .
bodylessInitializerDeclaration = initializerHead genericParameterClause? parameterClause "async"? throwsClause? functionResult? genericWhereClause? .
bodylessInitializerDeclaration = initializerHead genericParameterClause? parameterClause "async"? "rethrows" functionResult? genericWhereClause? .
initializerHead = attributes? declarationModifiers? "init" .
initializerHead = attributes? declarationModifiers? "init" "?" .   // space allowed: swift-syntax accepts `init ?(…)` (no >s< — the `?`/`!` may be separated from `init`)
initializerHead = attributes? declarationModifiers? "init" "!" .
initializerBody = codeBlock .

// Grammar of a deinitializer declaration

//deinitializerDeclaration = attributes? "deinit" codeBlock .
// swift-syntax: modifiers before deinit (Modifiers.swift), `async` effect after deinit
// via parseDeinitEffectSpecifiers (Specifiers.swift:721); body optional via parseOptionalCodeBlock.
deinitializerDeclaration = attributes? declarationModifiers? "deinit" "async"? codeBlock? .

// Declaration types allowed as the argument to `@abi(...)` — mirrors swift-syntax
// ABIAttributeArgumentsSyntax.Provider (8 cases; import/class/struct/etc. are NOT included).
abiDeclaration = associatedTypeDeclaration | deinitializerDeclaration | enumCaseDeclaration
               | functionDeclaration | initializerDeclaration | bodylessInitializerDeclaration
               | subscriptDeclaration | abiSubscriptDeclaration
               | typealiasDeclaration | variableDeclaration | constantDeclaration | abiVariableDeclaration .
// ABI signatures may be bodyless (they are declarations-without-implementation):
abiSubscriptDeclaration = subscriptHead subscriptResult genericWhereClause? .        // `subscript(i:) -> E` with no accessor block
abiVariableDeclaration  = variableDeclarationHead variableName getterSetterBlock .   // `var v { get set }` with no type annotation


// Grammar of an extension declaration

extensionDeclaration = attributes? accessLevelModifier? "extension" typeIdentifier typeInheritanceClause? genericWhereClause? extensionBody .
extensionBody = "{" extensionMembers? "}" .

extensionMembers = extensionMember ";"? .
extensionMembers = extensionMember statementSeparator extensionMembers .
extensionMember = memberDeclaration | compilerControlStatement .
// Swift 6.3 grammar bug see issue https://github.com/swiftlang/swift-book/issues/201

// Grammar of a subscript declaration

// A bare `{ stmts }` body (implicit getter) is already covered by `getterSetterBlock = codeBlock`
// (see above), so no separate `… codeBlock` alternate is needed — it only duplicated this one.
// Mirrors variableDeclaration, which likewise routes the implicit-getter block through getterSetterBlock.
subscriptDeclaration = subscriptHead subscriptResult genericWhereClause? getterSetterBlock .
subscriptHead = attributes? declarationModifiers? "subscript" genericParameterClause? parameterClause .
subscriptResult = "->" type .   // result-type attributes carried by `type`

// Grammar of a macro declaration

macroDeclaration = macroHead hardIdentifier genericParameterClause? macroSignature macroDefinition? genericWhereClause? . // TODO: verify that genericWhereClause? is a correct grammar fix.
macroHead = attributes? declarationModifiers? "macro" .
macroSignature = parameterClause macroFunctionSignatureResult? .
macroFunctionSignatureResult = "->" type .
macroDefinition = assignmentOperator expression .

// Grammar of an operator declaration

operatorDeclaration = prefixOperatorDeclaration | postfixOperatorDeclaration | infixOperatorDeclaration .

//prefixOperatorDeclaration = "prefix" "operator" operator .
//postfixOperatorDeclaration = "postfix" "operator" operator .
prefixOperatorDeclaration = "prefix" "operator" operator infixOperatorGroup? .   // TODO: swift-syntax accepts ':' clause syntactically on all fixities
postfixOperatorDeclaration = "postfix" "operator" operator infixOperatorGroup? .
infixOperatorDeclaration = "infix" "operator" operator infixOperatorGroup? .

//infixOperatorGroup = ":" precedenceGroupName .
infixOperatorGroup = ":" precedenceGroupName designatedTypes? . // TODO: grammar fix
designatedTypes = "," | "," designatedType designatedTypes? .   // trailing comma allowed (swift-syntax tolerates `operator : Prec,`)
designatedType = identifier | escapedIdentifier | nonWordToken | literal | operator .   // swift-syntax consumes ANY token here (deprecated feature) — identifier/escapedIdentifier catch all word tokens, nonWordToken the rest

// Grammar of a precedence group declaration

precedenceGroupDeclaration = "precedencegroup" precedenceGroupName "{" precedenceGroupAttributes? "}" .

precedenceGroupAttributes = precedenceGroupAttribute precedenceGroupAttributes? .
precedenceGroupAttribute = precedenceGroupRelation .
precedenceGroupAttribute = precedenceGroupAssignment .
precedenceGroupAttribute = precedenceGroupAssociativity .

precedenceGroupRelation = "higherThan" ":" precedenceGroupNames .
precedenceGroupRelation = "lowerThan" ":" precedenceGroupNames .

precedenceGroupAssignment = "assignment" ":" booleanLiteral .

precedenceGroupAssociativity = "associativity" ":" "left" .
precedenceGroupAssociativity = "associativity" ":" "right" .
precedenceGroupAssociativity = "associativity" ":" "none" .

precedenceGroupNames = precedenceGroupName | precedenceGroupName "," precedenceGroupNames .
precedenceGroupName = hardIdentifier .

// Grammar of a declaration modifier

// Mirrors swift-syntax DeclarationModifier set (TokenSpecSet.swift:350-386).
// Position constraints (e.g. async only after parameter clause) are semantic, not syntactic;
// swift-syntax accepts all of these in the modifier list and the compiler diagnoses misuse later.
declarationModifier = "class" | "convenience" | "dynamic" | "final" | "infix" | "lazy" | "optional" | "override" | "postfix" | "prefix" | "required" | "static" | "unowned" | "unowned" "(" "safe" ")" | "unowned" "(" "unsafe" ")" | "weak" .
declarationModifier = "async" | "borrowing" | "consuming" | "sending" | "distributed" | "reasync" | "indirect" | "isolated" .
declarationModifier = "_const" | "_local" | "__consuming" | "__setter_access" .
declarationModifier = accessLevelModifier .
declarationModifier = mutationModifier .
declarationModifier = actorIsolationModifier .
declarationModifiers = declarationModifier declarationModifiers? .

accessLevelModifier = "private" | "private" "(" "set" ")" .
accessLevelModifier = "fileprivate" | "fileprivate" "(" "set" ")" .
accessLevelModifier = "internal" | "internal" "(" "set" ")" .
accessLevelModifier = "package" | "package" "(" "set" ")" .
accessLevelModifier = "public" | "public" "(" "set" ")" .
accessLevelModifier = "open" .   // C5: no `open(set)` — `open` is never a setter access level (compiler rejects; swift-syntax only tolerates it, and reads a leading `open(set)` as a call). Dropping the alternate rejects `open(set) var` / `open open(set) var` (testAccessLevelModifier#1/#2).

mutationModifier = "mutating" | "nonmutating" .

actorIsolationModifier = "nonisolated" | "nonisolated" "(" "unsafe" ")" | "nonisolated" "(" "nonsending" ")" .   // swift-syntax parseNonisolatedModifier (Modifiers.swift): decl-modifier arg is exactly {unsafe, nonsending} (probe: safe/sending/mutating/foo all reject), and a space before `(` is allowed (no >s<, unlike the TYPE specifier at parameterModifier). Bare 'isolated' decl modifier is experimental (.nonescapableTypes) and skipped per policy.



// ATTRIBUTES

// Grammar of an attribute

// `@longest`: an attribute greedily takes its (tight) argument clause. Without this,
// `@derivative(of: x)⏎func f()` is ambiguous — the attribute could skip its args, leaving
// `(of: x)` to be misread as a type (making `@derivative` a bare expression-statement).
// swift-syntax always takes a tight `(…)` as attribute args (probe-verified: a bare attribute
// like `@derivative(of: x)` alone is a MissingDecl error, not an expression), so prefer the
// longest attribute. Safe because the arg clause only matches a TIGHT `(` (see >s< below).

// `@abi(decl)` — argument must be one of the 8 Provider types (swift-syntax ABIAttributeArgumentsSyntax.Provider).
// Argument is required; empty `@abi()` and bare `@abi` are both rejected.

// TODO: why no @longest here?
attribute = "@" >s< "abi" >s< "(" abiDeclaration ")" .

// `@isolated(x)` (SE-0431) — the argument is a plain identifier (`any` in valid code; swift-syntax's
// parser accepts any identifier here and defers the `any`-only check to sema, so `@isolated(sdfhsdfi)`
// parses). A dedicated rule so the argument is NOT the balanced-token soup: `@isolated(Swift::any)`
// rejects (a module selector leaves `::any` as unexpected code — testModuleSelectorAttrs).
attribute = "@" >s< "isolated" >s< "(" identifier ")" .

// @attached / @freestanding — swift-syntax parseMacroRoleArguments: role (identifier or `extension`)
// followed by parseArgumentListElements. The name arguments (`named(…)`, `prefixed(…)`, …) are
// decl-reference-names, so per parseDeclReferenceBase (Names.swift) only `init`/`deinit`/`subscript`/
// `self`/`Self` (and identifiers) are valid keyword names — every OTHER hard keyword is rejected
// (`named(class)` fails). Encoded as token-soup whose identifier atom excludes those forbidden
// keywords. `literal` is omitted so `named(true)`/`named(nil)` stay rejected.
@longest
attribute = "@" >s< "attached"     >s< "(" macroRoleArguments? ")" .
@longest
attribute = "@" >s< "freestanding" >s< "(" macroRoleArguments? ")" .
@longest
attribute = "@" >-> ( "abi" "attached" "freestanding" "isolated" ) >s< attributeName attributeArgumentClause? .
// Module-qualified attribute name = a custom attribute → its args are an EXPRESSION argument list, not
// the balanced-token soup builtins allow. `@main::available(macOS 10.15, *)` rejects (availability spec
// is not an expression arg list); `@main::available(foo: bar)` accepts.
@longest
attribute = "@" >-> ( "abi" "attached" "freestanding" "isolated" ) >s< moduleSelector attributeName attributeArgumentExprClause? .
attributeArgumentExprClause = >s< "(" functionCallArgumentList? ")" .

macroRoleArguments = macroRoleToken macroRoleArguments? .
// `::` is NOT listed: the scanner already yields a Schrödinger `:`/`::` dual, so the module
// selector in `Swift::deinit` is covered by two `nonWordToken` `:`s. Adding a `"::"` atom created
// a SECOND same-span reading → ambiguous pivot (testModuleSelectorExpr#8/#9).
macroRoleToken = identifier
                 ---( "_" "Any" "as" "associatedtype" "await" "break" "case" "catch" "class" "continue" "default" "defer" "do" "else" "enum" "fallthrough" "false" "fileprivate" "for" "func" "guard" "if" "import" "in" "inout" "internal" "is" "let" "nil" "open" "operator" "precedencegroup" "private" "protocol" "public" "repeat" "rethrows" "return" "static" "struct" "super" "switch" "throw" "throws" "true" "try" "typealias" "var" "where" "while" )
               | escapedIdentifier
               | nonWordToken
               | operator .
macroRoleToken = "(" macroRoleArguments? ")" .
macroRoleToken = "[" macroRoleArguments? "]" .
macroRoleToken = "{" macroRoleArguments? "}" .

// swift-syntax parseAttributeName = parseSimpleType(forAttributeName:) — the attribute name is a
// type identifier: member-qualified (`@Foo.Bar`), generic (`@Foo<Int>`), or escaped (`@`name``).
// `typeIdentifier` already builds on `typeName = identifier` (incl. escaped + propertyWrapperProjection).
// Module-FREE attribute name: the leading component is a plain type name (no `moduleSelector`), so a
// module-qualified attribute (`@main::available`) does NOT match this balanced-token rule — it is a
// CUSTOM attribute and goes through the strict-args rule below (swift-syntax: a module-qualified
// attribute must be a custom attribute, so `@main::available(macOS 10.15, *)` — availability-spec
// args — rejects, while `@main::available(foo: bar)` — an expression arg list — is fine).
attributeName = attributeHeadName typeGenericArgumentClause?
              | attributeHeadName typeGenericArgumentClause? "." typeIdentifier
              | "rethrows" .   // @rethrows: `rethrows` keyword remapped to identifier attr-name (swift-syntax Attributes.swift:328-330)
attributeHeadName = hardIdentifier | selfType .

// `>s<`: the argument-clause `(` must be tight (no space after the attribute name). swift-syntax
// requires this — `@available (macOS 11, *)` (space) is an error, `@available(macOS 11, *)` is not
// (probe-verified). So a spaced `(` after an attribute belongs to a following type, not the args.
attributeArgumentClause = >s< "(" balancedTokens? ")" .

attributes = attribute attributes? .
attributes = conditionalCompilationAttributes attributes? .    // TODO: SE-0367
conditionalCompilationAttributes = ifDirectiveAttributes elseifDirectiveAttributes? elseDirectiveAttributes? endifDirective .
ifDirectiveAttributes = ifDirective compilationCondition attributes? .
elseifDirectiveAttributes = elseifDirectiveAttributes elseifDirectiveAttributes? .
elseifDirectiveAttributes = elseifDirective compilationCondition attributes? .
elseDirectiveAttributes = elseDirective attributes? .

// Non-word residue for the token-soup contexts (balancedToken, designatedType). It holds ONLY
// tokens that are NOT identifier-shaped words: `#`-directives, `_`, `@`, and the punctuation
// `! ? = &` that operatorToken can't match alone (they need a continuation char). ALL keywords
// (`class`, `async`, `some`, …) and word literals (`true`/`false`/`nil`) are caught by identifier
// instead — a single word-token route, so no identifier-vs-keyword or keyword-vs-operator duals.
// Single-char operators `< > | ^ ~ % * + - /` are caught by the `operator` sibling alternate.
nonWordToken = "#available" | "#colorLiteral" | "#elseif" | "#else" | "#endif" | "#error" | "#fileLiteral" | "#if" | "#imageLiteral" | "#keyPath" | "#selector" | "#sourceLocation" | "#unavailable" | "#warning" | "." | "," | ":" | ";" | "=" | "#" | "&" | "?" | "!" | "_" | "@".

balancedToken = @prefer identifier
              | escapedIdentifier
              | nonWordToken
              | literal
              | operator .
// @prefer identifier over literal: `true`/`false`/`nil` are keyword-shaped and match BOTH; in attribute token-soup (`@_specialize(exported: true, …)`) they are raw keyword tokens, so take the identifier reading. Numbers/strings match only `literal`, so they're unaffected.
//balancedToken = Any identifier, keyword, literal, or operator .
//balancedToken = Any punctuation except (, ), [, ], {, or } .

balancedTokens = balancedToken balancedTokens? .

balancedToken = "(" balancedTokens? ")" .
balancedToken = "[" balancedTokens? "]" .
balancedToken = "{" balancedTokens? "}" .


// PATTERNS

//bindingPattern / matchPattern split, see https://raw.githubusercontent.com/swiftlang/swift-book/main/TSPL.docc/ReferenceManual/Patterns.md

// Grammar of a pattern

//pattern = wildcardPattern typeAnnotation? .
//pattern = identifierPattern typeAnnotation? .
//pattern = valueBindingPattern .
//pattern = tuplePattern typeAnnotation? .
//pattern = enumCasePattern .
//pattern = optionalPattern .
//pattern = typeCastingPattern .
//pattern = expressionPattern .

// Binding patterns — let/var declarations, optional binding conditions (if let, guard let)
bindingPattern = wildcardPattern typeAnnotation? .
bindingPattern = identifierPattern typeAnnotation? .
bindingPattern = tupleBindingPattern typeAnnotation? .

tupleBindingPattern = "(" tupleBindingElementList? ")" .
tupleBindingElementList = tupleBindingElement | tupleBindingElement "," tupleBindingElementList .
tupleBindingElement = bindingSubpattern | softIdentifier ":" bindingSubpattern .
// Tuple sub-patterns carry NO type annotation — swift-syntax forbids typed sub-patterns
// (`((x): Int, y)` is rejected; only the top-level binding is annotated). Reusing the annotated
// `bindingPattern` here made `x: Int` parse BOTH as label `x` + pattern `Int` AND as pattern `x`
// + annotation `: Int` — the residual `tupleBindingElement` ambiguity. This structural split
// (annotation-free sub-pattern) removes the spurious typed reading without an @prefer.
bindingSubpattern = wildcardPattern | identifierPattern | tupleBindingPattern .

// Match patterns — case labels, if/guard/for case, catch clauses.
// No `typeAnnotation?` here (unlike bindingPattern): in match context swift-syntax parses
// these as expressionPattern (see @prefer note below), and type-annotated bindings go through
// bindingPattern. Keeping every alternate single-symbol lets `@prefer expressionPattern` fire
// (PreferRule keys on the alternate's last body symbol, which a trailing nullable OPT defeats).
matchPattern = wildcardPattern .
matchPattern = identifierPattern .
matchPattern = valueBindingPattern .
matchPattern = tupleMatchPattern .
matchPattern = enumCasePattern .
matchPattern = optionalPattern .
matchPattern = typeCastingPattern .
// swift-syntax `parseMatchingPattern` parses everything except `is`/`let`/`var` as an
// expression: `case _:`→ExpressionPattern(DiscardAssignmentExpr), `case .foo:`/`Foo.bar`→
// ExpressionPattern(MemberAccessExpr), `case (x,y):`→ExpressionPattern(TupleExpr) (verified
// via swift-syntax probe). The Wildcard/Identifier/EnumCase pattern nodes are Sema's, not the
// parser's. `@prefer` the expression reading over the structural siblings at the same start;
// `let`/`var`/`is` survive (not expressions) and `.foo(let x)` stays on enumCasePattern (an
// embedded `let` is not a valid expression, so no expression reading competes there).
// swift-syntax canParsePattern (Patterns.swift:285) / canParsePatternTuple (Patterns.swift:331):
// the pattern-vs-expression fork; `let`/`var`/`is` are the true pattern forms, everything else is an expression.
matchPattern = @prefer expressionPattern .

// Grammar of a tuple pattern

tupleMatchPattern = "(" tupleMatchElementList? ")" .
tupleMatchElementList = tupleMatchElement | tupleMatchElement "," tupleMatchElementList .
tupleMatchElement = matchPattern | softIdentifier ":" matchPattern .

// Grammar of a wildcard pattern

wildcardPattern = "_" .

// Grammar of an identifier pattern

//identifierPattern = identifier .
identifierPattern = hardIdentifier | "self" .       // Swift syntax error, 'self' is allowed as an identifier in optional-binding-condition  TODO: WTF???

//valueBindingPattern = "var" pattern | "let" pattern .

//tuplePattern = "(" tuplePatternElementList? ")" .
//tuplePatternElementList = tuplePatternElement | tuplePatternElement "," tuplePatternElementList .
//tuplePatternElement = pattern | softIdentifier ":" pattern .

//enumCasePattern = typeIdentifier? "." enumCaseName tuplePattern? .

// Grammar of an optional pattern

optionalPattern = identifierPattern >s< optionalMark .                       // disallow space before '?'

// Grammar of a value-binding pattern

// Match-only patterns
// swift-syntax ValueBindingPatternSyntax.BindingSpecifierOptions (Parser+TokenSpecSet.swift:4112-4142):
// let, var, inout, borrowing, plus the experimental reference-binding specifiers _borrowing,
// _consuming, _mutating. We include the experimental ones to match swift-syntax fully.
valueBindingPattern = "var" matchPattern
                    | "let" matchPattern
                    | "inout" matchPattern
                    | "borrowing" >+> ( identifier "_" ) matchPattern .
valueBindingPattern = "_borrowing" >+> ( identifier "_" ) matchPattern
                    | "_consuming" matchPattern
                    | "_mutating" matchPattern .

// `>+>(identifier "_")`: port of swift-syntax `shouldParsePatternBinding` (Patterns.swift:274) —
// `borrowing`/`_borrowing` introduce a value-binding pattern ONLY when the next token is an identifier
// or `_` (`peek(isAt: .identifier, .wildcard)`). So `case borrowing(let x)` (next `(`) is the enum-case
// pattern `borrowing(…)`, not a binding. Only these two introducers are gated in swift; let/var/inout/
// _consuming/_mutating are unconditional.

// Grammar of an enumeration case pattern

enumCasePattern = typeIdentifier? "." enumCaseName tupleMatchPattern? .
// SE-0036 — leading-dot-less enum-case pattern. swift-syntax's `parseMatchingPattern` accepts
// a bare `Name(args)` form when the enum type is inferable from context; the compiler validates.
enumCasePattern = enumCaseName tupleMatchPattern .

// Grammar of a type casting pattern

typeCastingPattern = isPattern .
isPattern = "is" type .

// asPattern removed: `x as T` in a pattern is a SequenceExpr → already covered by `@prefer expressionPattern` (probe: dump-parse shows sequence_expr).
//The dedicated `asPattern = matchPattern "as" type` only ever added the spurious `(let x) as T` reading (let binds outermost) — a residual matchPattern ambiguity — and was never the faithful shape.
//asPattern = matchPattern "as" type .

// Grammar of an expression pattern

expressionPattern = expression .


// GENERIC PARAMETERS AND ARGUMENTS

// Grammar of a generic parameter clause

// declaration-position generic params are unambiguous — no follow-restriction (unlike expression-position genericArgumentClause)
genericParameterClause  = openAngle genericParameterList ","? closeAngle .

genericParameterList = genericParameter | genericParameter "," genericParameterList .
// swift-syntax GenericParameterSyntax carries `attributes` PER PARAMETER, so `<T, @foo U>`
// (attribute on a non-first parameter) is valid — hence attributes? attaches here, not before the list.
genericParameter = attributes? typeName .
genericParameter = attributes? typeName ":" "~"? typeIdentifier .          // TODO: T: P or T: ~Copyable (SE-0390)
genericParameter = attributes? typeName ":" "~"? protocolCompositionType . // TODO: T: P & Q or T: ~(P & Q)
genericParameter = attributes? "let" typeName ":" type .
//genericParameter = typeName ":" typeIdentifier .
//genericParameter = typeName ":" protocolCompositionType .

genericWhereClause = "where" requirementList .
requirementList = requirement | requirement "," requirementList .

requirement = conformanceRequirement | sameTypeRequirement .

//conformanceRequirement = typeIdentifier ":" typeIdentifier .
//conformanceRequirement = typeIdentifier ":" protocolCompositionType .
// TODO: LHS is typeIdentifier (compiler-correct — only nominal types can have constraints).
// RHS allows "~"? for SE-0390 suppressed conformance (T: ~Copyable in where clauses).
// swift-syntax accepts function types etc. on LHS but compiler rejects those — we follow compiler.

conformanceRequirement = typeIdentifier ":" "~"? typeIdentifier .
conformanceRequirement = typeIdentifier ":" "~"? protocolCompositionType .
sameTypeRequirement = typeIdentifier "==" type .
sameTypeRequirement = typeIdentifier "==" signedIntegerLiteral .

// Grammar of a generic argument clause

// Expression-position generic args: the `>+>(...)` follow-restriction is swift-syntax's
// `isGenericTypeDisambiguatingToken` set (Types.swift:1478) — what may legally follow `>` for the
// `<...>` to be read as generic args rather than comparison operators (`a < b > c`).
// Closing '>' commits only when followed by a Swift-approved disambiguation token —
// mirrors swift-syntax canParseAsGenericArgumentList. EOS is approved by default.

genericArgumentClause = openAngle genericArgumentList ","? closeAngle
                        >+> ( "(" ")" "[" "]" "{" "}" "," ";" ":" "." "?" "!" ">" ) .
                        
// Type position uses `typeGenericArgumentClause` (no follow restriction): swift-syntax
// parseTypeIdentifier (Types.swift:418-420) commits to generic args unconditionally on `<` —
// there's no `Foo<Bar>` vs `a < b > c` ambiguity in type position. The `>+>`-restricted
// `genericArgumentClause` is reserved for expression position.

typeGenericArgumentClause = openAngle genericArgumentList ","? closeAngle .

genericArgumentList = genericArgument | genericArgument "," genericArgumentList .
genericArgument = type | signedIntegerLiteral .

^^^
// testKeyPathMethodAndInitializers#17
_ = f(\String?.!.count)
^^^
// testKeyPathFollowedByOperator#2
\Foo?.?.?.blah
