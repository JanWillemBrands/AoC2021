// TOKENS

// Grammar of trivia
whitespace  : /\s+/ .
comment     : /\/\/.*/ .
action      : /'(?:[^'\\]|\\.)*'/ .

// Grammar of terminals
identifier  - /[_\p{XID_Start}][-\p{XID_Continue}]*/ .
literal     - /\"(?:[^\"\\]|\\.)+\"/ .
regex       - /\/(?!\*)(?:[^\/\\]|\\.)+\// .

// Grammar of pragma attributes
pragma      - /@\p{XID_Start}\p{XID_Continue}*/ .

// Grammar of test messages
message     - /\^\^\^(?:(?s).*?)(?=\^\^\^|$)/ .

// PRODUCTIONS

grammar     = < production > { message } .
              
production  = { pragma }
              identifier ( ":" | "-" | "=" ) alternates "."
              [ lookahead ] . // TODO: only <-< negative lookbehind sits here, mistakenly ?

alternates  = sequence { "|" sequence } .

sequence    = < factor [ "?" | "*" | "+" ]
              | layout
              | pragma
              > .

factor      = terminal
            | "[" selection "]"
            | "{" selection "}"
            | "<" selection ">"
            | "(" selection ")"
            .

terminal    = identifier [ exclusion ]
            | literal
            | regex
            | "ε" | "\"\""
            .

// Grammar of annotations

exclusion   = "---" "(" < literal > ")" .

layout      = ">>|" | "|<<" | "<n>" | "<s>" | ">n<" | ">s<" .

lookahead   = ( "<+<" | "<-<" | ">+>" | ">->" ) "(" < literal | Identifier > ")" .


^^^
whitespace  : /\s+/ .
comment     : /\/\/.*/ .

identifier  - /\p{XID_Start}\p{XID_Continue}*/ .
literal     - /\"(?:[^\"\\]|\\.)+\"/ .
regex       - /\/(?!\*)(?:[^\/\\]|\\.)+\// .

action      : /'(?:[^'\\]|\\.)*'/ .
pragma      - /@\p{XID_Start}\p{XID_Continue}*/ .
message     - /\^\^\^(?:(?s).*?)(?=\^\^\^|$)/ .

_gr-amm_ar     = < production > { message } .
              
production  = [ pragma ] identifier
                ( ":" ( regex | literal ) "." [ follow ]
                | "-" ( regex | literal ) "." [ follow ]
                | "-:" selection "."
                | "=" selection "."
                ) .

selection   = sequence { "|" sequence } .

sequence    = < factor [ "?" | "*" | "+" ] | layout > .

factor      = terminal
            | "[" selection "]"
            | "{" selection "}"
            | "<" selection ">"
            | "(" selection ")"
            .

terminal    = identifier    [ "---" "(" < literal > ")" ]
            | literal
            | regex
            | epsilon | empty
            .

epsilon     = "ε" .
empty       = "\"\"" .

layout      = ">>|" | "|<<" | "<n>" | "<s>" | ">n<" | ">s<" .

follow      = ( "<+<" | "<-<" ) "(" < literal > ")" .
