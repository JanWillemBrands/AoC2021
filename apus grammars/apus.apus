// GRAMMAR OF APUS, A GRAMMAR DEFINITION LANGUAGE

// Grammar of trivia
whitespace  : /\s+/ .
comment     : /\/\/.*/ .
action      : /'(?:[^'\\]|\\.)*'/ .

// Grammar of terminals
identifier  - /[_\p{XID_Start}][-\p{XID_Continue}]*/ .
literal     - /\"(?:[^\"\\]|\\.)+\"/ .
regex       - /\/(?!\*)(?:[^\/\\]|\\.)+\// .

// Grammar of pragmas
pragma      - /@\p{XID_Start}\p{XID_Continue}*/ .

// Grammar of test messages
message     - /\^\^\^(?:(?s).*?)(?=\^\^\^|$)/ .

// Grammar of production rules
grammar     = < production > { message } .
              
production  = { pragma } identifier ( ":" | "-" | "=" ) alternates "." .

alternates  = sequence { "|" sequence } .

sequence    = < factor [ "?" | "*" | "+" ]
              | spacing
              | pragma
              | lookaround
              > .

factor      = terminal
            | "[" alternates "]"
            | "{" alternates "}"
            | "<" alternates ">"
            | "(" alternates ")"
            .

terminal    = identifier [ exclusion ]
            | literal
            | regex
            | "ε" | "\"\""
            .

// Grammar of annotations

exclusion   = "---" "(" < literal > ")" .

spacing     = ">>|" | "|<<" | "<n>" | "<s>" | ">n<" | ">s<" .

lookaround  = ( "<+<" | "<-<" | ">+>" | ">->" ) "(" < literal | identifier | "EOF" > ")" .


