digraph G {
  fontname = Menlo
  fontsize = 10
  node [fontname = Menlo, fontsize = 10, color = gray, height = 0, width = 0, margin= 0.04]
  edge [fontname = Menlo, fontsize = 10, color = gray, arrowsize = 0.3]
  graph [ranksep = 0.1]
  rankdir = "TB"
  subgraph CallReturnForest {
    cluster = true
    label = <↵xxx↵> fontcolor = green
    labeljust = l
    node [shape = box, style = rounded, height = 0]
    0.0[any] [label = <S,0[any]<br/><font color="gray" point-size="8.0"> 5[utf8]</font>>]
    2.0[any] [label = <S={"x"}·,0[any]<br/><font color="gray" point-size="8.0"> 2[utf8]</font>>]
    2.0[any] -> 2.0[any]
    2.2[utf8] [label = <S={"x"}·,2[utf8]<br/><font color="gray" point-size="8.0"> 3[utf8]</font>>]
    2.2[utf8] -> 2.0[any]
    2.3[utf8] [label = <S={"x"}·,3[utf8]<br/><font color="gray" point-size="8.0"> 5[utf8]</font>>]
    2.3[utf8] -> 2.0[any]
    2.5[utf8] [label = <S={"x"}·,5[utf8]<br/><font color="gray" point-size="8.0"> </font>>]
    2.5[utf8] -> 2.0[any]
    2.0[any] [label = <S={"x"}·,0[any]>]
  }
  subgraph clusterS {
    node [shape = box]
    label = <S = { ""x"" } .>
    labeljust = l
    SR0C0 [label = <0<br/>N S<br/>fi [, "x"]<br/>fo [○]<br/>am [] >]
    SR0C1 [label = <1<br/>ALT <br/>fi [, "x"]<br/>fo [○]<br/>am [] >]
    SR1C1 [label = <2<br/>KLN <br/>fi [, "x"]<br/>fo [○]<br/>am [] >]
    SR2C1 [label = <6<br/>END <br/>fi []<br/>fo [○]<br/>am [] >]
    SR1C1 -> SR2C1 [weight=100000000]
    SR1C2 [label = <3<br/>ALT <br/>fi ["x"]<br/>fo ["x", ○]<br/>am [] >]
    SR2C2 [label = <4<br/>T ""x""<br/>fi ["x"]<br/>fo ["x", ○]<br/>am [] >]
    SR3C2 [label = <5<br/>END <br/>fi []<br/>fo ["x", ○]<br/>am [] >]
    SR2C2 -> SR3C2 [weight=100000000]
    SR1C2 -> SR2C2 [weight=100000000]
    rank = same {SR1C1 -> SR1C2}
    SR0C1 -> SR1C1 [weight=100000000]
    rank = same {SR0C0 -> SR0C1}
    node [style = invis]
    edge [style = invis]
    rank = same {SR0C1 -> SR0C2}
    SR0C0 -> SR1C0 [weight=100000000]
    rank = same {SR1C0 -> SR1C1}
    SR0C2 -> SR1C2 [weight=100000000]
    SR1C0 -> SR2C0 [weight=100000000]
    rank = same {SR2C0 -> SR2C1}
    SR2C0 -> SR3C0 [weight=100000000]
    SR2C1 -> SR3C1 [weight=100000000]
    rank = same {SR3C0 -> SR3C1}
    rank = same {SR3C1 -> SR3C2}
  }
}