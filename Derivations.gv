digraph Derivations {
  fontname=Menlo; fontsize=10
  node [fontname=Menlo, fontsize=10]
  edge [arrowsize=0.5]
  rankdir=TB; ordering=out; labelloc=t
  label=<S = { ""x"" } .>
  n0 [shape=ellipse, width=0, height=0, label=<S>]
  n1 [shape=box, width=0, height=0, label=<<br/>x>]
  n0 -> n1
  n2 [shape=box, width=0, height=0, label=<x>]
  n0 -> n2
  n3 [shape=box, width=0, height=0, label=<x>]
  n0 -> n3
  { rank=same; n1; n2; n3 }
  n1 -> n2 [style=invis]
  n2 -> n3 [style=invis]
}
